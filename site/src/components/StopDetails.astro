---
import { render, type CollectionEntry } from "astro:content";
import ContactAction from "./ContactAction.astro";
import FactRows from "./FactRows.astro";
import type { ContactDetails } from "../lib/contact";

/**
 * The things Amy does, step by step: one block each with its lead, her words,
 * a few facts and the way to book it. On wide screens a list of the stops stays
 * beside the blocks and marks the one being read.
 */
interface Props {
  stops: CollectionEntry<"chapters">[];
  contact: ContactDetails;
}

const { stops, contact } = Astro.props;
const blocks = await Promise.all(
  stops.map(async (stop) => ({
    stop,
    Content: (await render(stop)).Content,
  })),
);
---

<section class="details" aria-labelledby="details-title">
  <div class="details__aside">
    <h2 class="caption" id="details-title">
      Step by step
    </h2>
    <nav class="details__nav" aria-label="What I do, step by step">
      <ol data-spy>
        {stops.map((stop) => (
          <li>
            <a href={`#${stop.id}`}>{stop.data.nav ?? stop.data.title}</a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
  <div class="details__blocks">
    {blocks.map(({ stop, Content }) => (
      <section
        class="detail"
        id={stop.id}
        data-draft={stop.data.draft ? "" : undefined}
        aria-labelledby={`${stop.id}-title`}
      >
        <header class="detail__head">
          <h3 id={`${stop.id}-title`}>{stop.data.title}</h3>
          {stop.data.note && <p class="hand">{stop.data.note}</p>}
        </header>
        {stop.data.lead && <p class="detail__lead">{stop.data.lead}</p>}
        <div class="prose detail__body">
          <Content />
        </div>
        {stop.data.badge && <p class="detail__badge">{stop.data.badge}</p>}
        {stop.data.facts.length > 0 && <FactRows facts={stop.data.facts} />}
        {stop.data.cta && (
          <ContactAction
            channel={stop.data.cta.channel}
            details={contact}
            message={stop.data.cta.message}
            label={stop.data.cta.label}
            primary
          />
        )}
      </section>
    ))}
  </div>
</section>

<script>
  // Mark the stop being read in the side list. Without this script every name
  // keeps its full colour and stays a plain link.
  const list = document.querySelector<HTMLElement>("[data-spy]");
  if (list) {
    const pairs = [...list.querySelectorAll("a")].flatMap((link) => {
      const block = document.getElementById(link.hash.slice(1));
      return block ? [{ link, block }] : [];
    });
    // The stop being read is the block that crosses the middle of the screen.
    const mark = () => {
      const middle = window.innerHeight / 2;
      for (const { link, block } of pairs) {
        const { top, bottom } = block.getBoundingClientRect();
        if (top <= middle && bottom > middle) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    };
    window.addEventListener("scroll", mark, { passive: true });
    window.addEventListener("resize", mark);
    mark();
    list.dataset.spy = "on";
  }
</script>

<style>
  .details {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-12) var(--page-margin);
  }

  .details__nav {
    display: none;
  }

  .details__nav ol {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .details__nav a {
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
    text-decoration: none;
    transition: color var(--dur-state) var(--ease-out);
  }

  .details__nav ol[data-spy="on"] a:not([aria-current]) {
    color: var(--text-2);
  }

  .details__nav a:hover {
    color: var(--text);
  }

  .detail {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding-block: var(--space-6) var(--space-8);
    border-top: 1px solid var(--line);
  }

  .detail > :global(.rows) {
    justify-self: stretch;
  }

  .detail__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }

  .detail__head h3 {
    font-size: var(--step-4);
  }

  .detail__head .hand {
    rotate: var(--tilt-n2);
  }

  .detail__lead {
    font-size: var(--step-1);
    line-height: 1.35;
    max-width: 32ch;
  }

  .detail__body {
    color: var(--text-2);
  }

  .detail__badge {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: var(--step--1);
    font-weight: 600;
  }

  @media (min-width: 60rem) {
    .details {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-8);
    }

    .details__aside {
      position: sticky;
      top: calc(var(--bar-height) + var(--space-4));
      align-self: start;
    }

    .details__nav {
      display: block;
    }
  }
</style>
