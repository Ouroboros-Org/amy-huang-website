---
/** Short facts as hairline rows: a muted label, then its value. */
interface Props {
  facts: { label: string; value: string }[];
}

const { facts } = Astro.props;
---

<dl class="rows">
  {facts.map((fact) => (
    <div class="rows__row">
      <dt>{fact.label}</dt>
      <dd>{fact.value}</dd>
    </div>
  ))}
</dl>

<style>
  .rows {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .rows__row {
    display: grid;
    grid-template-columns: minmax(7rem, 1fr) 3fr;
    gap: var(--space-2);
    padding-block: var(--space-2);
    border-top: 1px solid var(--line);
  }

  dt {
    color: var(--text-2);
  }

  dd {
    margin: 0;
    font-weight: 600;
  }
</style>
