---
/**
 * Always on screen: her name and role back to the start, the section links, the
 * control that stops all motion and video (WCAG 2.2.2), and the one main action.
 * The motion control is hidden when the reader's system already asks for reduced
 * motion, because then nothing moves.
 *
 * The bar has two looks. Over the light page it is a blurred strip of the page
 * colour with dark type. Over a section marked `data-bar-tone="light"` (the hero,
 * the about photo, the footer) it is clear with light type on a soft shade. A
 * small script switches between them; without it the bar keeps the strip, which
 * reads everywhere.
 */
interface Props {
  name: string;
  role: string;
  links: { label: string; href: string }[];
}

const { name, role, links } = Astro.props;
---

<header class="bar" data-bar>
  <a class="bar__id" href="/#top">
    <span class="bar__name">{name}</span>
    <span class="bar__role">{role}</span>
  </a>
  <nav class="bar__nav" aria-label="Sections">
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
  <div class="bar__actions">
    <!-- The label names the action; "motion" is hidden visually on narrow screens. -->
    <button class="bar__motion" type="button" data-motion-toggle>
      <span data-motion-verb>Pause</span>
      <span class="bar__wide"> motion</span>
    </button>
    <a class="bar__hi" href="#contact">
      Say hi
    </a>
  </div>
</header>

<script>
  import {
    motionPaused,
    onMotionChange,
    setMotionPaused,
  } from "../scripts/motion";

  const button = document.querySelector<HTMLButtonElement>(
    "[data-motion-toggle]",
  );
  const verb = button?.querySelector("[data-motion-verb]");
  if (button && verb) {
    const render = () => {
      verb.textContent = motionPaused() ? "Play" : "Pause";
    };
    button.addEventListener("click", () => setMotionPaused(!motionPaused()));
    onMotionChange(render);
    render();
  }

  // Light type while the bar lies over a section that asks for it.
  const bar = document.querySelector<HTMLElement>("[data-bar]");
  const toned = [...document.querySelectorAll<HTMLElement>("[data-bar-tone]")];
  if (bar && toned.length > 0) {
    const tone = () => {
      const middle = bar.offsetHeight / 2;
      const over = toned.find((section) => {
        const { top, bottom } = section.getBoundingClientRect();
        return top <= middle && bottom > middle;
      });
      bar.dataset.tone = over?.dataset.barTone ?? "";
    };
    window.addEventListener("scroll", tone, { passive: true });
    window.addEventListener("resize", tone);
    tone();
  }
</script>

<style>
  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: var(--bar-height);
    padding-inline: var(--page-margin);
    background: color-mix(in oklch, var(--bg) 85%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    font-size: var(--step--1);
    line-height: 1.35;
    transition:
      background-color var(--dur-state) var(--ease-out),
      color var(--dur-state) var(--ease-out);
  }

  .bar[data-tone="light"] {
    --text-2: oklch(0.97 0 0 / 0.78);
    background: linear-gradient(
      to bottom,
      oklch(0.16 0.006 262 / 0.5),
      transparent
    );
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    color: var(--on-media);
  }

  .bar a,
  .bar button {
    text-decoration: none;
  }

  .bar__id {
    display: grid;
    margin-right: auto;
    min-width: 0;
  }

  .bar__name {
    font-weight: 600;
  }

  .bar__role {
    color: var(--text-2);
    white-space: nowrap;
  }

  .bar__nav {
    display: none;
    gap: var(--space-3);
  }

  .bar__nav a,
  .bar__motion {
    padding: 0.4rem 0;
    font-weight: 600;
    color: var(--text-2);
    transition: color var(--dur-state) var(--ease-out);
  }

  .bar__nav a:hover,
  .bar__motion:hover {
    color: inherit;
  }

  .bar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .bar__motion {
    border: 0;
    background: none;
    font-family: inherit;
    font-size: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    white-space: nowrap;
    cursor: pointer;
  }

  .bar__hi {
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--signal);
    color: var(--signal-text);
    font-weight: 600;
    white-space: nowrap;
  }

  .bar[data-tone="light"] :focus-visible {
    outline-color: var(--on-media);
  }

  @media (min-width: 48rem) {
    .bar__nav {
      display: flex;
    }

    .bar__actions {
      gap: var(--space-3);
    }
  }

  @media (max-width: 30rem) {
    .bar__wide {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .bar__role {
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar__motion {
      display: none;
    }
  }
</style>
