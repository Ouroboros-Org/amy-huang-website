---
import AlphaVideo from "./AlphaVideo.astro";
import ContactLinks from "./ContactLinks.astro";
import Contents from "./Contents.astro";
import Print from "./Print.astro";
import StickyNote from "./StickyNote.astro";

/**
 * The first screen (S0): who she is, every offering and every way to reach her,
 * without scrolling. Amy's cut-out steps out of the taped print.
 */
interface Props {
  name: string;
  line: string;
  currentlyIn: string;
  still: { src: string; alt: string; width: number; height: number };
  cutout: { src: string; alt: string; width: number; height: number };
  contents: { title: string; page: number; href: string; starred?: boolean }[];
  contact: { whatsapp?: string; email?: string; instagram?: string };
  headingLevel?: "h1" | "h2";
  /** Unique per page when a page shows more than one cover. */
  id?: string;
}

const {
  name,
  line,
  currentlyIn,
  still,
  cutout,
  contents,
  contact,
  headingLevel: Heading = "h1",
  id = "cover",
} = Astro.props;
---

<div class="cover grid">
  <div class="cover__intro">
    <p class="cover__hi hand" aria-hidden="true">
      hi, I'm
    </p>
    <Heading class="cover__name">
      <span class="visually-hidden">Hi, I'm </span>
      {name}
    </Heading>
    <p class="cover__line">{line}</p>
    <div class="cover__contact">
      <ContactLinks details={contact} />
    </div>
  </div>

  <!-- Placement lives on wrappers Cover owns: its scoped styles don't reach into child components. -->
  <div class="cover__print">
    <Print tilt="n2" {...still}>
      <AlphaVideo class="cover__cutout" {...cutout} />
    </Print>
  </div>

  <div class="cover__side">
    <Contents entries={contents} id={`${id}-contents`} />
    <div class="cover__sticky">
      <StickyNote tilt="p3">
        currently in:
        <br />
        {currentlyIn}
      </StickyNote>
    </div>
  </div>
</div>

<style>
  .cover {
    row-gap: var(--space-6);
    align-items: start;
    padding-block: var(--space-8);
  }

  .cover__intro,
  .cover__print,
  .cover__side {
    grid-column: 1 / -1;
  }

  .cover__hi {
    font-size: var(--step-3);
    rotate: var(--tilt-n2);
    translate: -0.15em 0.15em;
    width: max-content;
  }

  .cover__name {
    font-size: var(--step-6);
    letter-spacing: -0.035em;
  }

  .cover__line {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    line-height: 1.35;
    max-width: 22ch;
  }

  .cover__contact {
    margin-top: var(--space-4);
  }

  .cover__print {
    max-width: 26rem;
  }

  .cover__print :global(.cover__cutout) {
    position: absolute;
    right: -14%;
    bottom: -10%;
    width: 46%;
    rotate: var(--tilt-p2);
  }

  .cover__sticky {
    margin-top: var(--space-4);
  }

  @media (min-width: 48rem) {
    .cover__print {
      grid-column: 1 / span 4;
    }

    .cover__side {
      grid-column: 5 / span 4;
    }
  }

  @media (min-width: 72rem) {
    .cover {
      min-height: 100svh;
      align-content: center;
    }

    .cover__intro {
      grid-column: 1 / span 5;
    }

    .cover__print {
      grid-column: 6 / span 4;
    }

    .cover__side {
      grid-column: 10 / span 3;
    }
  }
</style>
