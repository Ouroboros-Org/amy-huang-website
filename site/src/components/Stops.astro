---
import type { CollectionEntry } from "astro:content";
import BackgroundMedia from "./BackgroundMedia.astro";

/**
 * The overview: one large card per thing Amy does. Each card sticks below the
 * top bar and the next one slides up over it, so scrolling pages through all of
 * them. A card leads to its block in the step-by-step details (StopDetails).
 * The stacking is plain `position: sticky`, so it needs no script.
 */
interface Props {
  stops: CollectionEntry<"chapters">[];
}

const { stops } = Astro.props;
---

<section class="stops" id="work" aria-labelledby="work-title">
  <h2 class="caption" id="work-title">
    What I do
  </h2>
  <div class="stops__stack">
    {stops.map((stop) => (
      <article class="stop" id={`card-${stop.id}`}>
        {stop.data.background && (
          <BackgroundMedia {...stop.data.background} alt="" />
        )}
        <div class="stop__scrim" />
        <div class="stop__text">
          {stop.data.kicker && <p class="stop__kicker">{stop.data.kicker}</p>}
          <h3 class="stop__name">
            <a href={`#${stop.id}`}>{stop.data.nav ?? stop.data.title}</a>
          </h3>
          <span class="stop__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
              <path
                d="M12 5v14m0 0-6-6m6 6 6-6"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .stops {
    padding: var(--space-8) var(--page-margin) 0;
  }

  .stops__stack {
    margin-top: var(--space-2);
  }

  .stop {
    position: sticky;
    top: calc(var(--bar-height) + var(--space-1));
    display: grid;
    place-items: center;
    height: calc(100vh - var(--bar-height) - var(--space-4));
    height: calc(100svh - var(--bar-height) - var(--space-4));
    min-height: 20rem;
    max-height: 52rem;
    margin-bottom: var(--space-3);
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--night);
    color: var(--on-media);
    container-type: inline-size;
  }

  .stop__scrim {
    position: absolute;
    inset: 0;
    background: var(--scrim);
  }

  .stop__text {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-3);
    text-align: center;
  }

  .stop__kicker {
    font-weight: 600;
    line-height: 1.3;
  }

  .stop__name {
    font-size: clamp(3rem, 11cqw, 8rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  /* The whole card is the link's target. */
  .stop__name a {
    text-decoration: none;
  }

  .stop__name a::after {
    content: "";
    position: absolute;
    inset: -100vmax;
  }

  .stop__arrow {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-top: var(--space-2);
    border: 1px solid oklch(0.97 0 0 / 0.5);
    border-radius: 50%;
    background: oklch(0.16 0.006 262 / 0.35);
    transition: background-color var(--dur-state) var(--ease-out);
  }

  .stop:hover .stop__arrow,
  .stop:focus-within .stop__arrow {
    background: var(--on-media);
    color: var(--night);
  }

  .stop__name a:focus-visible {
    outline-color: var(--on-media);
  }
</style>
