---
import { Picture } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import photo from "../assets/about/photo.webp";

/**
 * Who she is, over a photo of her: a large statement, her words, and a
 * handwritten note pointing at her.
 *
 * The photo is wide and Amy stands left of its centre. On wide screens the
 * section is a screen tall: the text keeps to the right, where a dusk shade
 * makes it readable, and she stays clear on the left. On narrow ones the text
 * comes first on dusk, and the photo rises out of the dusk below it, with room
 * kept for her, so the text never runs over her.
 */
interface Props {
  entry: CollectionEntry<"chapters">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, lead, note, photoAlt, draft } = entry.data;
---

<section
  class="about"
  id={entry.id}
  data-draft={draft ? "" : undefined}
  data-drift-root
  data-bar-tone="light"
  aria-labelledby={`${entry.id}-title`}
>
  <div class="about__media" data-drift="5">
    <Picture
      src={photo}
      alt={photoAlt ?? ""}
      widths={[960, 1440, 2000]}
      sizes="(orientation: portrait) 220vh, (max-aspect-ratio: 7/3) 234vh, 100vw"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      loading="lazy"
    />
  </div>
  <div class="about__shade" aria-hidden="true"></div>
  <div class="about__content">
    <h2 class="about__statement" id={`${entry.id}-title`} data-reveal>
      {lead ?? title}
    </h2>
    <div class="about__bio" data-reveal="block">
      <p class="caption">{title}</p>
      <div class="prose">
        <Content />
      </div>
    </div>
    {note && (
      <p class="about__note hand">
        {note}
        <svg
          viewBox="0 0 64 32"
          width="56"
          height="28"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3 22c14 8 34 6 52-10m0 0-11 1m11-1-3 11"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </p>
    )}
  </div>
</section>

<style>
  .about {
    --dusk: oklch(0.2 0.045 262);
    --photo-h: 92vh;
    position: relative;
    display: grid;
    overflow: hidden;
    background: var(--dusk);
    color: var(--on-media);
  }

  @supports (height: 1svh) {
    .about {
      --photo-h: 92svh;
    }
  }

  /* Narrow: the photo at the foot, fading up into the dusk behind the text.
     Taller than its place, so the drift never shows an edge. */
  .about__media {
    position: absolute;
    inset: auto 0 -6%;
    height: var(--photo-h);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 30%);
    mask-image: linear-gradient(to bottom, transparent, #000 30%);
  }

  .about__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Amy stands about a third of the way across the photo. */
    object-position: 31% 50%;
  }

  /* A little night at the foot, for the note. */
  .about__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      oklch(0.16 0.006 262 / 0.7),
      transparent 12rem
    );
  }

  /* The last row keeps most of a screen clear for her, the note at its foot. */
  .about__content {
    --text-2: oklch(0.97 0 0 / 0.78);
    position: relative;
    display: grid;
    grid-template-rows: auto auto minmax(calc(var(--photo-h) * 0.72), 1fr);
    gap: var(--space-4);
    padding: calc(var(--bar-height) + var(--space-4)) var(--page-margin)
      var(--space-4);
  }

  .about__statement {
    justify-self: end;
    max-width: 18ch;
    font-size: var(--step-3);
    line-height: 1.25;
    text-align: right;
  }

  .about__bio {
    display: grid;
    gap: var(--space-2);
    justify-self: end;
    max-width: 26rem;
  }

  .about__note {
    display: flex;
    align-items: end;
    gap: var(--space-1);
    align-self: end;
    justify-self: start;
    rotate: var(--tilt-n2);
    color: var(--on-media);
  }

  /* Wide screens: a screen tall at least, text on the right, Amy clear on the left. */
  @media (min-width: 60rem) and (orientation: landscape) {
    .about {
      min-height: max(100vh, 44rem);
      min-height: max(100svh, 44rem);
      background: var(--night);
    }

    .about__media {
      inset: -6% 0;
      height: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .about__shade {
      background:
        linear-gradient(
          to left,
          oklch(0.2 0.045 262 / 0.86) 0%,
          oklch(0.2 0.045 262 / 0.78) 36%,
          oklch(0.2 0.045 262 / 0.42) 54%,
          oklch(0.2 0.045 262 / 0.12) 70%,
          transparent 86%
        ),
        linear-gradient(to bottom, oklch(0.2 0.045 262 / 0.5), transparent 28%),
        linear-gradient(to top, oklch(0.16 0.006 262 / 0.7), transparent 22%);
    }

    .about__content {
      grid-template-rows: 1fr auto;
      grid-template-columns: 1fr minmax(0, 36rem);
      column-gap: var(--space-8);
    }

    .about__statement {
      grid-column: 2;
      align-self: start;
      font-size: var(--step-4);
    }

    .about__bio {
      grid-column: 2;
      grid-row: 2;
      justify-self: end;
      padding-bottom: var(--space-4);
    }

    .about__note {
      grid-column: 1;
      grid-row: 2;
      margin-left: 6%;
    }
  }
</style>
