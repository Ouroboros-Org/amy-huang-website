---
import Tape from "./Tape.astro";

type Tilt = "n4" | "n2" | "n1" | "p1" | "p2" | "p3";
type TapeAt = "top-left" | "top-right" | "top" | "bottom-left" | "bottom-right";

/**
 * A photo print taped into the diary: white border, soft shadow, a fixed tilt from
 * the token set. Anything in the default slot is positioned over the print, which
 * is how a cut-out of Amy steps out of its frame.
 */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  tilt?: Tilt;
  tape?: TapeAt[];
  caption?: string;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  tilt = "n1",
  tape = ["top-left", "top-right"],
  caption,
  class: className,
} = Astro.props;
---

<figure class:list={["print", className]} style={`--tilt: var(--tilt-${tilt})`}>
  <div class="print__frame">
    {tape.map((at) => (
      <Tape at={at} />
    ))}
    <img src={src} alt={alt} width={width} height={height} loading="lazy" />
  </div>
  {caption && <figcaption class="hand">{caption}</figcaption>}
  <slot />
</figure>

<style>
  .print {
    position: relative;
    margin: 0;
    rotate: var(--tilt);
  }

  .print__frame {
    position: relative;
    padding: clamp(0.5rem, 2.5%, 1rem);
    padding-bottom: clamp(1.25rem, 8%, 3rem);
    background: var(--print-border);
    box-shadow: var(--shadow-paper);
  }

  .print__frame img {
    width: 100%;
    height: auto;
  }

  figcaption {
    position: absolute;
    bottom: 0.15rem;
    left: clamp(0.5rem, 2.5%, 1rem);
    font-size: 1.25rem;
  }
</style>
