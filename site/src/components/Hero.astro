---
import { Picture } from "astro:assets";
import front from "../assets/hero/front.webp";
import sky from "../assets/hero/sky.webp";

/**
 * The opening: Amy's photo in two layers, edge to edge and taller than the
 * screen, with her name between the layers. The title sits in the sky and the
 * main peak overlaps its lower edge; the subheadline sits on the mountain face
 * below. With motion allowed, scripts/parallax.ts lets the sky and the title lag
 * behind the mountains as the page scrolls, so the title sinks behind the peaks.
 *
 * The sky is darkened toward dusk, so the white title reads on it and the top
 * bar reads over it.
 *
 * Everything is placed on a stage with the photo's 4:5 proportions, sized to
 * cover the section, so text and ridge line up on any screen. Phones see the
 * middle of the photo at full height; wide screens see the full width from just
 * above the title down.
 */
interface Props {
  title: string;
  subtitle: string;
  /** Describes the photo. */
  alt: string;
}

const { title, subtitle, alt } = Astro.props;
const widths = [640, 960, 1280, 1600, 2400];
// The stage is at least 112% of the screen height wide (4:5 of a 140svh section).
const sizes = "(max-aspect-ratio: 28/25) 112vh, 100vw";
---

<section
  class="hero"
  id="top"
  data-parallax-root
  data-bar-tone="light"
  aria-labelledby="hero-title"
>
  <div class="hero__stage">
    <h1 class="hero__title" id="hero-title" data-parallax="0.3">
      {title}
    </h1>
    <p class="hero__subtitle">{subtitle}</p>
    <div class="hero__layer hero__layer--sky" data-parallax="0.45">
      <Picture
        src={sky}
        alt=""
        widths={[640, 960, 1280, 1600]}
        sizes={sizes}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        loading="eager"
      />
    </div>
    <div class="hero__layer hero__layer--front">
      <Picture
        src={front}
        alt={alt}
        widths={widths}
        sizes={sizes}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
  <a class="hero__cue" href="#gallery">
    <span class="hero__cue-label hand">scroll</span>
    <span class="hero__cue-arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
        <path
          d="M12 4v16m0 0-6-6m6 6 6-6"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: 140vh;
    height: 140svh;
    overflow: hidden;
    container-type: size;
    /* The photo's sky at dusk, shown until the layers arrive. */
    background: #4a5a70;
    color: var(--on-media);
  }

  .hero__stage {
    /* Cover the section at the photo's 4:5. On wide screens the stage is taller
       than the section; it then starts 9% down the photo, just above the title. */
    --stage-height: max(100cqh, 125cqw);
    position: absolute;
    left: 50%;
    top: max(
      calc(100cqh - var(--stage-height)),
      calc(var(--stage-height) * -0.09)
    );
    width: calc(var(--stage-height) * 0.8);
    height: var(--stage-height);
    translate: -50% 0;
    container-type: size;
  }

  .hero__layer {
    position: absolute;
    inset: 0;
  }

  .hero__layer :global(img) {
    width: 100%;
    height: 100%;
  }

  /* Dusk: deepest at the top, easing toward the ridge. The mountains cover the rest. */
  .hero__layer--sky::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      oklch(0.2 0.045 262 / 0.78) 0%,
      oklch(0.2 0.045 262 / 0.6) 14%,
      oklch(0.2 0.045 262 / 0.52) 26%,
      oklch(0.2 0.045 262 / 0.3) 36%,
      transparent 50%
    );
  }

  /* Back to front: sky, title, mountains, subheadline. */
  .hero__layer--sky {
    z-index: 0;
  }

  .hero__title {
    z-index: 1;
  }

  .hero__layer--front {
    z-index: 2;
  }

  .hero__subtitle {
    z-index: 3;
  }

  /* The main peak's tip is 20.5% down the photo. The title's baseline sits a
     quarter of its size below that, so the tip always reaches into the letters. */
  .hero__title {
    --size: min(13cqw, 21vw);
    position: absolute;
    left: 0;
    right: 0;
    top: calc(20.5cqh + var(--size) * 0.25 - var(--size) * 0.86);
    margin: 0;
    font-size: var(--size);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.06em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* On the dark mountain face below the peak, clear of the sky on both sides. */
  .hero__subtitle {
    position: absolute;
    left: 50%;
    top: calc(20.5cqh + min(13cqw, 21vw) * 0.25 + 6.5cqh);
    width: min(31cqw, 80vw);
    max-width: none;
    translate: -50% 0;
    font-size: clamp(1rem, 1.4cqw, 1.375rem);
    font-weight: 300;
    line-height: 1.35;
    text-align: center;
    text-wrap: balance;
  }

  /* The cue sits at the foot of the first screen, not of the taller section. */
  .hero__cue {
    position: absolute;
    left: 50%;
    top: calc(100vh - 7.5rem);
    top: calc(100svh - 7.5rem);
    z-index: 4;
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    translate: -50% 0;
    text-decoration: none;
  }

  .hero__cue-label {
    rotate: var(--tilt-n2);
    color: inherit;
  }

  .hero__cue-arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid oklch(0.97 0 0 / 0.55);
    border-radius: 50%;
    background: oklch(0.16 0.006 262 / 0.3);
    animation: cue 1.8s var(--ease-soft) infinite;
  }

  .hero__cue:hover .hero__cue-arrow,
  .hero__cue:focus-visible .hero__cue-arrow {
    border-color: var(--signal);
    background: var(--signal);
    color: var(--signal-text);
  }

  .hero__cue:focus-visible {
    outline-color: var(--on-media);
  }

  :global(:root[data-motion="off"]) .hero__cue-arrow {
    animation-play-state: paused;
  }

  @keyframes cue {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(0.5rem);
    }
  }
</style>
