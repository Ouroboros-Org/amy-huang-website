---
import { Picture } from "astro:assets";
import front from "../assets/hero/front.webp";
import sky from "../assets/hero/sky.webp";

/**
 * The opening: Amy's photo in two layers (scripts/split-hero.mjs) inside a
 * rounded card, with her name between the layers. The title sits in the sky and
 * the main peak overlaps its lower edge; the subheadline sits on the mountain
 * face below. Her line follows under the card. With motion allowed,
 * scripts/parallax.ts lets the sky and the title lag behind the mountains as the
 * page scrolls, so the title sinks behind the peaks.
 *
 * Everything in the card is placed on a stage with the photo's 4:5 proportions,
 * sized to cover the card, so text and ridge line up on any screen. Phones see
 * the full height with the sides cropped; wide screens see the full width from
 * just above the title down to the meadow.
 */
interface Props {
  title: string;
  subtitle: string;
  /** Describes the photo. */
  alt: string;
  /** The sentence under the card. */
  line: string;
}

const { title, subtitle, alt, line } = Astro.props;
const widths = [640, 960, 1280, 1600];
// The stage is 80% of the card's height wide on screens narrower than 4:5.
const sizes = "(max-aspect-ratio: 4/5) 80vh, 100vw";
---

<section class="hero" id="top" data-parallax-root aria-labelledby="hero-title">
  <div class="hero__card">
    <div class="hero__stage">
      <h1 class="hero__title" id="hero-title" data-parallax="0.3">
        {title}
      </h1>
      <p class="hero__subtitle">{subtitle}</p>
      <div class="hero__layer hero__layer--sky" data-parallax="0.45">
        <Picture
          src={sky}
          alt=""
          widths={widths}
          sizes={sizes}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          loading="eager"
        />
      </div>
      <div class="hero__layer hero__layer--front">
        <Picture
          src={front}
          alt={alt}
          widths={widths}
          sizes={sizes}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
  <p class="hero__line">{line}</p>
</section>

<style>
  .hero {
    /* Room under the card for her line: two lines of text and their padding. */
    --hero-foot: 6rem;
    padding: var(--bar-height) var(--page-margin) 0;
  }

  .hero__card {
    position: relative;
    height: calc(100vh - var(--bar-height) - var(--hero-foot));
    height: calc(100svh - var(--bar-height) - var(--hero-foot));
    min-height: 20rem;
    overflow: hidden;
    border-radius: var(--radius-card);
    container-type: size;
    /* The photo's sky, shown until the layers arrive. */
    background: #a4bacd;
  }

  .hero__stage {
    /* Cover the card at the photo's 4:5. On wide screens the stage is taller than
       the card; it then starts 9% down the photo, just above the title. */
    --stage-height: max(100cqh, 125cqw);
    position: absolute;
    left: 50%;
    top: max(
      calc(100cqh - var(--stage-height)),
      calc(var(--stage-height) * -0.09)
    );
    width: calc(var(--stage-height) * 0.8);
    height: var(--stage-height);
    translate: -50% 0;
    container-type: size;
  }

  .hero__layer {
    position: absolute;
    inset: 0;
  }

  .hero__layer :global(img) {
    width: 100%;
    height: 100%;
  }

  /* Back to front: sky, title, mountains, subheadline. */
  .hero__layer--sky {
    z-index: 0;
  }

  .hero__title {
    z-index: 1;
  }

  .hero__layer--front {
    z-index: 2;
  }

  .hero__subtitle {
    z-index: 3;
  }

  /* Baseline 22.75% down the photo: the main peak's tip reaches into the letters. */
  .hero__title {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(22.75cqh - 0.87em);
    margin: 0;
    font-size: 12cqw;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    text-align: center;
    white-space: nowrap;
    color: var(--night);
  }

  /* On the dark mountain face below the peak, clear of the sky on both sides. */
  .hero__subtitle {
    position: absolute;
    left: 50%;
    top: 29cqh;
    width: 31cqw;
    max-width: none;
    translate: -50% 0;
    font-size: clamp(1rem, 1.4cqw, 1.375rem);
    line-height: 1.35;
    text-align: center;
    text-wrap: balance;
    color: var(--on-media);
  }

  .hero__line {
    display: flex;
    align-items: center;
    min-height: var(--hero-foot);
    max-width: 34ch;
    line-height: 1.4;
    text-wrap: balance;
  }
</style>
