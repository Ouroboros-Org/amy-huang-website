---
/**
 * The opening, after the rush of the intro (Intro.astro): a slow video of Amy,
 * looping full screen, with her motto set wide across it and her crafts
 * beneath.
 *
 * Right after the intro, which only the first load of a visit plays, it
 * breathes in: the video comes into focus from a blur, and the motto fades in,
 * grows and opens its letters out. Otherwise it is simply there.
 *
 * With motion allowed, the footage and the words hold still while the page
 * scrolls up over them, and scrolling down fades the words out as their letters
 * open wider. Without motion the hero scrolls with the page and the video rests
 * on its first frame.
 *
 * The motto is set like a film title: thin capitals, widely spaced. On wide
 * screens it is one line; on narrow ones each sentence takes a line.
 */
interface Props {
  motto: string;
  crafts: string[];
  /** Describes the video. */
  alt: string;
}

const { motto, crafts, alt } = Astro.props;
const phrases = motto.split(/(?<=[.!?])\s+/);
---

<section
  class="hero"
  id="top"
  data-hero
  data-bar-tone="light"
  aria-labelledby="hero-title"
>
  <video
    class="hero__video"
    muted
    playsinline
    loop
    preload="none"
    poster="/media/hero/amy.poster.webp"
    aria-label={alt}
  >
    <source
      media="(max-width: 60rem)"
      src="/media/hero/amy-720.mp4"
      type="video/mp4"
    />
    <source src="/media/hero/amy.mp4" type="video/mp4" />
  </video>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__words">
    <h1 class="hero__motto" id="hero-title">
      {phrases.map((phrase, index) => (
        <>
          {index > 0 && " "}
          <span class="hero__phrase">{phrase}</span>
        </>
      ))}
    </h1>
    <p class="hero__crafts">
      {crafts.map((craft, index) => (
        <>
          {index > 0 && (
            <span class="hero__dot" aria-hidden="true">
              ·
            </span>
          )}
          <span>{craft}</span>
        </>
      ))}
    </p>
  </div>
  <a class="hero__cue" href="#gallery">
    <span class="visually-hidden">Scroll down</span>
    <svg
      class="hero__cue-arrow"
      viewBox="0 0 14 56"
      width="14"
      height="56"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M7 1v53M1.5 48.5 7 54l5.5-5.5"
        stroke="currentColor"
        stroke-width="1"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
  </a>
</section>

<script>
  import { motionAllowed, onMotionChange } from "../scripts/motion";

  /** Share of the remaining distance the scroll fade covers per frame. */
  const EASE = 0.08;

  const root = document.documentElement;
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const video = hero?.querySelector("video");

  if (hero && video) {
    let revealed = false;
    let inView = true;

    const sync = () => {
      if (revealed && inView && motionAllowed()) {
        if (video.preload !== "auto") {
          video.preload = "auto";
          video.load();
        }
        video.play().catch(() => {
          // Refused (Low Power Mode, data saver): the poster stays.
        });
      } else if (!video.paused) {
        video.pause();
      }
    };

    const reveal = () => {
      if (revealed) return;
      revealed = true;
      if (motionAllowed()) video.currentTime = 0;
      sync();
      // After a paint of the waiting state, so the breath in runs as a transition.
      const mark = () => (hero.dataset.in = "");
      requestAnimationFrame(() => requestAnimationFrame(mark));
      window.setTimeout(mark, 250);
    };

    // Buffer while the intro plays, so she is there the moment it ends.
    if (motionAllowed()) {
      video.preload = "auto";
      video.load();
    }
    if (root.classList.contains("intro-on")) {
      addEventListener("intro:end", reveal, { once: true });
    } else {
      reveal();
    }

    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      sync();
    }).observe(hero);
    onMotionChange(sync);

    // How far the page has scrolled over the hero, 0 to 1, followed softly:
    // the styles fade the words out and open their letters by it.
    let current = 0;
    let frame = 0;
    const step = () => {
      const target = motionAllowed()
        ? Math.min(1, Math.max(0, scrollY / hero.offsetHeight))
        : 0;
      current += (target - current) * EASE;
      if (Math.abs(target - current) < 0.001) current = target;
      hero.style.setProperty("--hero-out", current.toFixed(4));
      frame = current === target ? 0 : requestAnimationFrame(step);
    };
    const wake = () => {
      if (!frame) frame = requestAnimationFrame(step);
    };
    addEventListener("scroll", wake, { passive: true });
    onMotionChange(wake);
    wake();
  }
</script>

<style>
  @property --track-in {
    syntax: "<length>";
    inherits: true;
    initial-value: 0px;
  }

  /* How far the page has scrolled over the hero, 0 to 1 (set by the script). */
  @property --hero-out {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  .hero {
    --track-out: 0.8em;
    position: relative;
    display: grid;
    place-items: center;
    height: 100vh;
    height: 100svh;
    min-height: 32rem;
    overflow: hidden;
    /* Also clips the pinned layers below, which overflow can't. */
    clip-path: inset(0);
    background: var(--night);
    color: var(--on-media);
  }

  /*
   * Pinned: the footage, its shade and the words hold still at the top of the
   * screen while the page scrolls up over them; the hero's clip shows them only
   * within its box. One small-viewport screen tall, as the hero is, so they
   * frame the same as when they scroll. Left out with motion off: a still
   * background under a moving page is parallax.
   */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion="off"])) .hero__video,
    :global(:root:not([data-motion="off"])) .hero__shade,
    :global(:root:not([data-motion="off"])) .hero__words {
      position: fixed;
      inset: 0 0 auto;
      height: 100vh;
      height: 100svh;
      min-height: 32rem;
    }

    :global(:root:not([data-motion="off"])) .hero__words {
      align-content: center;
      pointer-events: none;
    }
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The breath in: the footage first, the words after it, slower. */
    transition:
      filter 4.5s cubic-bezier(0.33, 0, 0.2, 1),
      scale 6s var(--ease-out);
  }

  /* Night over the footage, deeper in the middle where the words are. */
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        60% 46% at 50% 50%,
        oklch(0.16 0.006 262 / 0.42),
        transparent
      ),
      linear-gradient(
        to bottom,
        oklch(0.16 0.006 262 / 0.5),
        oklch(0.16 0.006 262 / 0.22) 30%,
        oklch(0.16 0.006 262 / 0.22) 70%,
        oklch(0.16 0.006 262 / 0.55)
      );
  }

  /* Fading out as the page scrolls over the hero, gone a little past halfway. */
  .hero__words {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding-inline: var(--page-margin);
    text-align: center;
    opacity: calc(1 - var(--hero-out) * 1.8);
  }

  /* A film title: thin capitals set wide, the one place letters are tracked out. */
  .hero__motto {
    --track-in: 0.62em;
    max-width: none;
    font-size: clamp(1rem, 2vw, 2.125rem);
    font-weight: 200;
    line-height: 1.9;
    /* Opening wider as it fades out. */
    letter-spacing: calc(var(--track-in) + var(--hero-out) * var(--track-out));
    text-transform: uppercase;
    /* One line; widening it never breaks it in two. */
    white-space: nowrap;
    transition:
      --track-in 8s 1.2s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 5s 1.6s var(--ease-soft),
      scale 8s 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Each sentence holds together. The same space before it as after its last
     letter, so it centres on its own line and the sentences breathe apart. */
  .hero__phrase {
    display: inline-block;
    padding-inline-start: calc(
      var(--track-in) + var(--hero-out) * var(--track-out)
    );
    white-space: nowrap;
  }

  /* Narrow screens: a sentence a line. */
  @media (max-width: 47.99rem) {
    .hero__motto {
      font-size: clamp(0.9375rem, 4.2vw, 1.125rem);
    }

    .hero__phrase {
      display: block;
    }
  }

  .hero__crafts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 1.1em;
    max-width: none;
    font-size: clamp(0.6875rem, 0.62rem + 0.25vw, 0.875rem);
    font-weight: 300;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: oklch(0.97 0 0 / 0.85);
    transition:
      opacity 4s 4.2s var(--ease-soft),
      translate 4s 4.2s var(--ease-out);
  }

  /* Each craft gives back its trailing space, so the dots sit midway. */
  .hero__crafts > span:not(.hero__dot) {
    margin-inline-end: -0.45em;
  }

  .hero__dot {
    letter-spacing: 0;
  }

  /* A hairline arrow at the foot of the screen. */
  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: var(--space-3);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 4.5rem;
    translate: -50% 0;
    color: oklch(0.97 0 0 / 0.8);
    /* Gone early on the way down, before it rises into the words. (Not
       opacity, which the breath in transitions.) */
    filter: opacity(max(0, 1 - var(--hero-out) * 4));
    transition:
      opacity 2.5s 7s var(--ease-soft),
      color var(--dur-state) var(--ease-out);
  }

  .hero__cue-arrow {
    animation: cue 2.4s var(--ease-soft) infinite;
  }

  .hero__cue:hover,
  .hero__cue:focus-visible {
    color: var(--on-media);
  }

  .hero__cue:focus-visible {
    outline-color: var(--on-media);
    outline-offset: 0;
    border-radius: var(--radius-pill);
  }

  :global(:root[data-motion="off"]) .hero__cue-arrow {
    animation-play-state: paused;
  }

  /*
   * Before the breath in (Intro.astro adds .hero-reveal when the intro plays;
   * the script above marks the hero data-in the moment it ends): the footage
   * blurred and a touch close, the words not yet there.
   */
  :global(:root.hero-reveal) .hero:not([data-in]) .hero__video {
    filter: blur(36px);
    scale: 1.12;
  }

  :global(:root.hero-reveal) .hero:not([data-in]) .hero__motto {
    --track-in: 0.2em;
    opacity: 0;
    scale: 0.88;
  }

  :global(:root.hero-reveal) .hero:not([data-in]) .hero__crafts {
    opacity: 0;
    translate: 0 0.75rem;
  }

  :global(:root.hero-reveal) .hero:not([data-in]) .hero__cue {
    opacity: 0;
  }

  @keyframes cue {
    0%,
    100% {
      transform: translateY(-0.25rem);
      opacity: 0.55;
    }
    50% {
      transform: translateY(0.25rem);
      opacity: 1;
    }
  }
</style>
