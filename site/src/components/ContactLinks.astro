---
import ContactAction from "./ContactAction.astro";
import type { Channel, ContactDetails } from "../lib/contact";

/** The three ways to reach Amy, WhatsApp first. */
interface Props {
  details: ContactDetails;
  size?: "regular" | "large";
  class?: string;
}

const { details, size = "regular", class: className } = Astro.props;
const channels: Channel[] = ["whatsapp", "email", "instagram"];
---

<ul class:list={["contact", className]}>
  {channels.map((channel) => (
    <li>
      <ContactAction
        channel={channel}
        details={details}
        primary={channel === "whatsapp"}
        size={size}
      />
    </li>
  ))}
</ul>

<style>
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
