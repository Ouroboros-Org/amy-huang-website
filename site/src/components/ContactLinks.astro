---
/**
 * The three ways to reach Amy. Missing details render as visibly unfinished
 * placeholders instead of invented numbers or handles.
 */
interface Props {
  whatsapp?: string;
  email?: string;
  instagram?: string;
  class?: string;
}

const { whatsapp, email, instagram, class: className } = Astro.props;

const links = [
  {
    label: "WhatsApp",
    href: whatsapp && `https://wa.me/${whatsapp.replace(/\D/g, "")}`,
    primary: true,
  },
  { label: "Email", href: email && `mailto:${email}` },
  {
    label: "Instagram",
    href:
      instagram && `https://www.instagram.com/${instagram.replace(/^@/, "")}/`,
  },
];
---

<ul class:list={["contact", className]}>
  {links.map((link) => (
    <li>
      {link.href ? (
        <a
          class:list={[
            "contact__link",
            { "contact__link--primary": link.primary },
          ]}
          href={link.href}
        >
          {link.label}
        </a>
      ) : (
        <span
          class:list={[
            "contact__link",
            { "contact__link--primary": link.primary },
          ]}
          data-placeholder="contact detail"
        >
          {link.label}
        </span>
      )}
    </li>
  ))}
</ul>

<style>
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact__link {
    display: inline-block;
    padding: 0.6rem 1.1rem;
    border: 2px solid currentColor;
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color var(--dur-state) var(--ease-out);
  }

  .contact__link--primary {
    border-color: var(--signal);
    background: var(--signal);
    color: var(--signal-text);
  }

  a.contact__link:hover {
    background: color-mix(in oklch, currentColor 10%, transparent);
  }

  a.contact__link--primary:hover {
    background: color-mix(in oklch, var(--signal) 85%, black);
  }

  span.contact__link {
    opacity: 0.55;
    border-style: dashed;
  }
</style>
