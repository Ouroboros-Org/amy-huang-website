---
import AlphaVideo from "./AlphaVideo.astro";

/**
 * The opening: a neutral, dark video with a transparent opening in its centre.
 * The first chapter lies underneath and shows through it; scrolling zooms the
 * hero through the opening. Name, line and the chapter index give everything at
 * a glance before the journey starts.
 */
interface Props {
  name: string;
  line: string;
  hero: {
    src: string;
    portrait?: string;
    width: number;
    height: number;
    alt: string;
  };
  index: { label: string; href: string }[];
}

const { name, line, hero, index } = Astro.props;
---

<section
  class="hero"
  id="top"
  data-chapter
  data-length="1.6"
  aria-labelledby="hero-title"
>
  <div
    class="hero__opening"
    data-layer
    data-out='{"scale":9,"ease":"power3.in"}'
    data-out-window="0.05 0.95"
  >
    <AlphaVideo {...hero} fit="cover" />
  </div>

  <div
    class="hero__title"
    data-layer
    data-out='{"opacity":0,"scale":1.35}'
    data-out-window="0 0.3"
  >
    <h1 id="hero-title">{name}</h1>
    <p>{line}</p>
  </div>

  <nav
    class="hero__index"
    aria-label="Chapters"
    data-layer
    data-out='{"opacity":0,"yPercent":60}'
    data-out-window="0 0.18"
  >
    <ul>
      {index.map((entry) => (
        <li>
          <a href={entry.href}>{entry.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .hero__opening {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
  }

  .hero__title {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    padding-inline: var(--page-margin);
    text-align: center;
    pointer-events: none;
  }

  .hero__title h1 {
    font-size: var(--step-6);
    letter-spacing: -0.035em;
  }

  .hero__title p {
    margin: var(--space-2) auto 0;
    font-size: var(--step-1);
    line-height: 1.3;
    max-width: 24ch;
  }

  .hero__index {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-6);
    padding-inline: var(--page-margin);
  }

  .hero__index ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__index a {
    display: inline-block;
    padding: var(--space-1) 0;
    font-weight: 600;
    text-decoration: none;
    color: var(--text-2);
    transition: color var(--dur-state) var(--ease-out);
  }

  .hero__index a:hover,
  .hero__index a:focus-visible {
    color: var(--text);
  }
</style>
