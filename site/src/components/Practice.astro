---
import { render, type CollectionEntry } from "astro:content";

/**
 * Her words about her practice, right below the gallery's sentence
 * (Gallery.astro), which is this chapter's title: a short centred column on the
 * light page that comes into focus as it scrolls in. The gallery's heading
 * covers it, so it has no heading of its own.
 */
interface Props {
  entry: CollectionEntry<"chapters">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<section
  class="practice"
  id={entry.id}
  data-draft={entry.data.draft ? "" : undefined}
>
  <div class="practice__words prose" data-reveal="block">
    <Content />
  </div>
</section>

<style>
  .practice {
    display: grid;
    justify-items: center;
    padding: var(--space-8) var(--page-margin) var(--space-16);
  }

  .practice__words {
    max-width: 38rem;
    font-size: var(--step-1);
    line-height: 1.5;
    text-align: center;
  }

  .practice__words :global(p) {
    margin-inline: auto;
  }

  .practice__words :global(p + p) {
    margin-top: var(--space-3);
  }
</style>
