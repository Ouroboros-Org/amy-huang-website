---
import { render, type CollectionEntry } from "astro:content";

/**
 * Her words about her practice, opening the work cards (Stops.astro) on the
 * same night: her first line large, the rest beside it. They come into focus
 * as they scroll in.
 *
 * The chapter's title is the gallery's sentence (Gallery.astro); its body is
 * shown here.
 */
interface Props {
  entry: CollectionEntry<"chapters">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<section
  class="practice"
  id={entry.id}
  data-draft={entry.data.draft ? "" : undefined}
  data-bar-tone="light"
  aria-labelledby={`${entry.id}-title`}
>
  <h2 class="caption" id={`${entry.id}-title`}>
    My practice
  </h2>
  <div class="practice__words" data-reveal="block">
    <Content />
  </div>
</section>

<style>
  .practice {
    --text: var(--on-media);
    --text-2: oklch(0.97 0 0 / 0.72);
    display: grid;
    gap: var(--space-4);
    padding: var(--space-16) var(--page-margin) var(--space-12);
    background: var(--night);
    color: var(--text);
  }

  .practice__words {
    display: grid;
    gap: var(--space-3);
  }

  /* Her first line, as a statement. */
  .practice__words :global(p:first-child) {
    max-width: 20ch;
    font-size: var(--step-4);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .practice__words :global(p:not(:first-child)) {
    max-width: 34rem;
    color: var(--text-2);
  }

  /* Wide screens: the statement on the left, the rest together at its foot on
     the right. */
  @media (min-width: 60rem) {
    .practice__words {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-rows: 1fr auto;
      column-gap: var(--space-8);
    }

    .practice__words :global(p:first-child) {
      grid-row: span 2;
    }

    .practice__words :global(p:nth-child(2)) {
      align-self: end;
    }
  }
</style>
