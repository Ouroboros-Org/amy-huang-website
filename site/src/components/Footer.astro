---
/**
 * The page's end, on night with the accent glowing up from below: where she is,
 * the wedding-hair link, the page's links, and her name as a wordmark across the
 * full width. The glow drifts slowly while motion is allowed.
 */
interface Props {
  name: string;
  currentlyIn: string;
  weddingsUrl?: string;
  links: { label: string; href: string }[];
}

const { name, currentlyIn, weddingsUrl, links } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer" id="footer" data-bar-tone="light">
  <div class="footer__glow" aria-hidden="true"></div>
  <div class="footer__fade" aria-hidden="true"></div>
  <div class="footer__row">
    <p class="footer__where">Currently in {currentlyIn}</p>
    <p>
      {weddingsUrl ? (
        <a href={weddingsUrl}>Wedding hair in Canada</a>
      ) : (
        <span data-placeholder="weddings link">
          [Wedding hair in Canada link]
        </span>
      )}
    </p>
    <nav aria-label="Footer">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <p class="footer__wordmark" aria-hidden="true">
    {name}
  </p>
  <p class="footer__legal">
    © {year} {name}
  </p>
</footer>

<style>
  .footer {
    --text-2: oklch(0.97 0 0 / 0.8);
    position: relative;
    display: grid;
    gap: var(--space-12);
    padding: var(--space-8) var(--page-margin) var(--space-3);
    overflow: hidden;
    container-type: inline-size;
    background: var(--night);
    color: var(--on-media);
  }

  /* Fire into dusk, rising from below the footer's edge. */
  .footer__glow {
    position: absolute;
    inset: 8% -12% -22%;
    background:
      radial-gradient(46% 70% at 12% 62%, var(--glow-1), transparent 72%),
      radial-gradient(40% 62% at 34% 84%, var(--glow-2), transparent 74%),
      radial-gradient(44% 72% at 55% 68%, var(--glow-3), transparent 74%),
      radial-gradient(42% 66% at 76% 86%, var(--glow-4), transparent 74%),
      radial-gradient(48% 76% at 94% 64%, var(--glow-5), transparent 74%);
    filter: blur(30px);
    animation: glow 26s var(--ease-soft) infinite alternate;
  }

  /* Night at the very top and bottom, so the small type reads at 4.5:1 or better. */
  .footer__fade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, var(--night) 0%, transparent 34%),
      linear-gradient(to top, oklch(0.16 0.006 262 / 0.6), transparent 14%);
  }

  .footer__row,
  .footer__wordmark,
  .footer__legal {
    position: relative;
  }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    color: var(--text-2);
  }

  .footer__row p {
    max-width: none;
  }

  /* A small live dot, as the theme marks availability. */
  .footer__where::before {
    content: "";
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    vertical-align: 0.05em;
  }

  .footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer a {
    text-decoration: none;
    transition: color var(--dur-state) var(--ease-out);
  }

  .footer a:hover {
    color: var(--on-media);
  }

  .footer :focus-visible {
    outline-color: var(--on-media);
  }

  /* Sized to span the footer: nine letters of Sora bold are about 5.4em wide. */
  .footer__wordmark {
    max-width: none;
    font-size: 17.6cqw;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .footer__legal {
    font-size: var(--step--1);
    color: var(--text-2);
  }

  :global(:root[data-motion="off"]) .footer__glow {
    animation-play-state: paused;
  }

  @keyframes glow {
    from {
      transform: translate3d(-4%, 2%, 0) scale(1);
    }
    to {
      transform: translate3d(4%, -3%, 0) scale(1.12);
    }
  }
</style>
