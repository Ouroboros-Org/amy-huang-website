---
/**
 * The page's end: where she is, the wedding-hair link, the section links, and
 * her name as a wordmark across the full width.
 */
interface Props {
  name: string;
  currentlyIn: string;
  weddingsUrl?: string;
  links: { label: string; href: string }[];
}

const { name, currentlyIn, weddingsUrl, links } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer" id="footer">
  <div class="footer__row">
    <p class="footer__where">Currently in {currentlyIn}</p>
    <p>
      {weddingsUrl ? (
        <a href={weddingsUrl}>Wedding hair in Canada</a>
      ) : (
        <span data-placeholder="weddings link">
          [Wedding hair in Canada link]
        </span>
      )}
    </p>
    <nav aria-label="Footer">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <p class="footer__wordmark" aria-hidden="true">
    {name}
  </p>
  <p class="footer__legal">
    © {year} {name}
  </p>
</footer>

<style>
  .footer {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6) var(--page-margin) var(--space-3);
    border-top: 1px solid var(--line);
    container-type: inline-size;
    overflow: hidden;
  }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    color: var(--text-2);
  }

  .footer__row p {
    max-width: none;
  }

  /* A small live dot, as the theme marks availability. */
  .footer__where::before {
    content: "";
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    vertical-align: 0.05em;
  }

  .footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer a {
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--text);
  }

  /* Sized to span the footer: nine letters of Sora bold are about 5.4em wide. */
  .footer__wordmark {
    max-width: none;
    font-size: 17.6cqw;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .footer__legal {
    font-size: var(--step--1);
    color: var(--text-2);
  }
</style>
