---
/**
 * The page's end: a quiet strip on the light page. Her name in the hero's thin,
 * widely spaced capitals, the page's links and the wedding-hair link, a way
 * back to the start; below them where she is, with a small live dot, and the
 * copyright line.
 */
interface Props {
  name: string;
  currentlyIn: string;
  weddingsUrl?: string;
  links: { label: string; href: string }[];
}

const { name, currentlyIn, weddingsUrl, links } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer" id="footer">
  <div class="footer__row">
    <p class="footer__name">{name}</p>
    <nav class="footer__links" aria-label="Footer">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      {weddingsUrl ? (
        <a href={weddingsUrl}>Wedding hair in Canada</a>
      ) : (
        <span data-placeholder="weddings link">
          [Wedding hair in Canada link]
        </span>
      )}
    </nav>
    <a class="footer__back" href="#">
      Back to the start
      <svg
        viewBox="0 0 14 28"
        width="10"
        height="20"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M7 27V2M1.5 7.5 7 2l5.5 5.5"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </a>
  </div>
  <div class="footer__row footer__row--small">
    <p class="footer__where">Currently in {currentlyIn}</p>
    <p>
      © {year} {name}
    </p>
  </div>
</footer>

<style>
  .footer {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6) var(--page-margin) var(--space-4);
    border-top: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .footer p {
    max-width: none;
  }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  .footer__row--small {
    color: var(--text-2);
  }

  /* The hero's film title, small. */
  .footer__name {
    font-size: 0.9375rem;
    font-weight: 300;
    letter-spacing: 0.45em;
    text-transform: uppercase;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }

  .footer a,
  .footer__links span {
    color: var(--text-2);
    text-decoration: none;
    transition: color var(--dur-state) var(--ease-out);
  }

  .footer__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  /* A small live dot, for where she is now. */
  .footer__where {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .footer__where::before {
    content: "";
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer a:hover {
      color: var(--text);
    }
  }

  /* Narrow screens: one item under the other. */
  @media (max-width: 47.99rem) {
    .footer__row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
