---
/**
 * A strip of tape holding something to the page. `src` takes a scan of real tape
 * (a cut-out PNG, WebP or AVIF with alpha). Without one it renders a plain
 * placeholder strip, marked `data-placeholder`, so missing scans are easy to find.
 */
interface Props {
  at: "top-left" | "top-right" | "top" | "bottom-left" | "bottom-right";
  src?: string;
}

const { at, src } = Astro.props;
---

{src ? (
  <img class:list={["tape", `tape--${at}`]} src={src} alt="" />
) : (
  <span class:list={["tape", `tape--${at}`]} data-placeholder="tape scan" />
)}

<style>
  .tape {
    position: absolute;
    z-index: 1;
    width: clamp(4rem, 22%, 7rem);
    height: 1.75rem;
    pointer-events: none;
    /* How far a corner strip reaches past the print; less on narrow screens. */
    --reach: -0.6rem;
  }

  @media (min-width: 48rem) {
    .tape {
      --reach: -1.25rem;
    }
  }

  span.tape {
    background: oklch(0.96 0.02 95 / 0.62);
    box-shadow: 0 1px 2px oklch(0.2 0.02 262 / 0.12);
  }

  .tape--top-left {
    top: -0.75rem;
    left: var(--reach);
    rotate: -32deg;
  }

  .tape--top-right {
    top: -0.75rem;
    right: var(--reach);
    rotate: 30deg;
  }

  .tape--top {
    top: -0.9rem;
    left: 50%;
    translate: -50% 0;
    rotate: -2deg;
  }

  .tape--bottom-left {
    bottom: -0.75rem;
    left: var(--reach);
    rotate: 28deg;
  }

  .tape--bottom-right {
    bottom: -0.75rem;
    right: var(--reach);
    rotate: -30deg;
  }
</style>
