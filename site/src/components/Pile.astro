---
import Print from "./Print.astro";

type Tilt = "n4" | "n2" | "n1" | "p1" | "p2" | "p3";

/**
 * A pile of taped prints: the first one large, the rest smaller and tucked under
 * its lower edge, alternating sides. Portrait prints are sized narrower than
 * landscape ones so a tall photo never fills the column. The overlap leaves each
 * print's caption strip visible. Tilts come from a fixed sequence so the pile
 * looks placed, not random.
 */
interface Props {
  media: {
    src: string;
    alt: string;
    width: number;
    height: number;
    caption?: string;
  }[];
}

const { media } = Astro.props;
const tilts: Tilt[] = ["n1", "p2", "n2", "p1"];
---

<div class="pile">
  {media.map((item, index) => (
    <div
      class:list={[
        "pile__item",
        { "pile__item--lead": index === 0 },
        { "pile__item--portrait": item.height > item.width },
        index % 2 === 1 ? "pile__item--right" : "pile__item--left",
      ]}
    >
      <Print
        {...item}
        tilt={tilts[index % tilts.length]}
        tape={index === 0 ? ["top-left", "top-right"] : ["top"]}
      />
    </div>
  ))}
</div>

<style>
  .pile {
    display: grid;
  }

  .pile__item {
    position: relative;
    width: 64%;
  }

  .pile__item--portrait {
    width: 50%;
  }

  .pile__item--lead {
    width: 100%;
  }

  .pile__item--lead.pile__item--portrait {
    width: 72%;
  }

  .pile__item + .pile__item {
    margin-top: -3%;
  }

  .pile__item--right {
    justify-self: end;
  }

  .pile__item--left:not(.pile__item--lead) {
    justify-self: start;
    margin-left: 6%;
  }
</style>
