---
/**
 * The diary's contents page: the site's navigation. Plain titles, dot leaders and
 * page numbers; Amy's star marks her main offerings.
 */
interface Entry {
  title: string;
  page: number;
  href: string;
  starred?: boolean;
}

interface Props {
  entries: Entry[];
  /** Unique per page, for the heading the navigation is labelled by. */
  id?: string;
  class?: string;
}

const { entries, id = "contents", class: className } = Astro.props;
---

<nav class:list={["contents", className]} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="contents__title">
    Contents
  </h2>
  <ol>
    {entries.map((entry) => (
      <li>
        <a href={entry.href}>
          <span class="contents__entry">
            {entry.title}
            {entry.starred && (
              <span class="contents__star hand">
                <span aria-hidden="true">✱</span>
                <span class="visually-hidden">(a main offering)</span>
              </span>
            )}
          </span>
          <span class="contents__leader" aria-hidden="true" />
          <span class="contents__page">
            <span class="visually-hidden">page</span> {entry.page}
          </span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .contents__title {
    font-size: var(--step-1);
    font-weight: 650;
    margin-bottom: var(--space-2);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    padding-block: calc(var(--rule-gap) / 4);
    font-size: var(--step-0);
    line-height: 1.35;
    text-decoration: none;
  }

  a:hover .contents__entry {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .contents__leader {
    flex: 1;
    min-width: var(--space-2);
    border-bottom: 2px dotted var(--text-2);
    translate: 0 -0.3em;
  }

  .contents__page {
    font-variant-numeric: tabular-nums;
  }

  .contents__star {
    display: inline-block;
    margin-inline-start: 0.2em;
    font-size: 1.25rem;
    line-height: 0;
    color: var(--signal);
    rotate: var(--tilt-p3);
  }
</style>
