---
/**
 * A sheet of the diary. The ruling is the Swiss baseline made visible, and the
 * margin line marks the grid's edge. `texture` takes a scan of real paper, laid
 * over with multiply; without one the sheet stays flat rather than faking grain.
 */
interface Props {
  kind?: "lined" | "graph" | "plain" | "kraft" | "night";
  margin?: boolean;
  texture?: string;
  as?: "section" | "div" | "article" | "header" | "footer";
  class?: string;
  [attribute: string]: unknown;
}

const {
  kind = "lined",
  margin = kind === "lined",
  texture,
  as: Tag = "div",
  class: className,
  ...rest
} = Astro.props;
---

<Tag
  class:list={[
    "paper",
    `paper--${kind}`,
    { "paper--margin": margin },
    className,
  ]}
  style={texture ? `--paper-texture: url("${texture}")` : undefined}
  {...rest}
>
  <slot />
</Tag>

<style>
  .paper {
    position: relative;
    background-color: var(--paper);
    color: var(--text);
  }

  .paper--lined {
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 calc(var(--rule-gap) - 1px),
      var(--rule) calc(var(--rule-gap) - 1px) var(--rule-gap)
    );
  }

  .paper--graph {
    background-image:
      repeating-linear-gradient(
        to bottom,
        transparent 0 calc(var(--rule-gap) / 2 - 1px),
        var(--rule) calc(var(--rule-gap) / 2 - 1px) calc(var(--rule-gap) / 2)
      ),
      repeating-linear-gradient(
        to right,
        transparent 0 calc(var(--rule-gap) / 2 - 1px),
        var(--rule) calc(var(--rule-gap) / 2 - 1px) calc(var(--rule-gap) / 2)
      );
  }

  .paper--kraft {
    background-color: var(--kraft);
  }

  .paper--night {
    background-color: var(--night);
    color: var(--gel);
    --ink: var(--gel);
    --text: var(--gel);
    --text-2: var(--night-text-2);
    /* 6.8:1 on night; dark text on it reads at the same ratio. */
    --signal: oklch(0.7 0.18 35);
    --signal-text: var(--night);
  }

  .paper--margin::before {
    content: "";
    position: absolute;
    inset-block: 0;
    left: var(--margin-line-x);
    width: 2px;
    background: var(--margin-line);
    pointer-events: none;
  }

  .paper[style*="--paper-texture"]::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--paper-texture) center / cover;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
</style>
