---
type Tilt = "n4" | "n2" | "n1" | "p1" | "p2" | "p3";

/** A spread's heading, with Amy's note scribbled above it. */
interface Props {
  id: string;
  title: string;
  note?: string;
  noteTilt?: Tilt;
  size?: "regular" | "large";
}

const { id, title, note, noteTilt = "n2", size = "regular" } = Astro.props;
---

<header class:list={["title", `title--${size}`]}>
  {note && (
    <p class="title__note hand" style={`--tilt: var(--tilt-${noteTilt})`}>
      {note}
    </p>
  )}
  <h2 id={`${id}-title`}>{title}</h2>
</header>

<style>
  .title h2 {
    font-size: var(--step-5);
  }

  .title--large h2 {
    font-size: var(--step-6);
  }

  .title__note {
    width: max-content;
    max-width: 100%;
    margin-bottom: var(--space-1);
    rotate: var(--tilt);
    translate: -0.1em 0;
  }
</style>
