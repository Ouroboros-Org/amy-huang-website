---
import { render, type CollectionEntry } from "astro:content";
import ContactLinks from "./ContactLinks.astro";
import type { ContactDetails } from "../lib/contact";

/**
 * The journey's calm last chapter: one clear way to reach Amy, her note, and the
 * page's footer details. Little motion, so the action never moves under a finger.
 */
interface Props {
  entry: CollectionEntry<"chapters">;
  contact: ContactDetails;
  name: string;
  currentlyIn: string;
  replyNote: string;
  weddingsUrl?: string;
}

const { entry, contact, name, currentlyIn, replyNote, weddingsUrl } =
  Astro.props;
const { Content } = await render(entry);
const { title, note, length, revealAt, draft } = entry.data;
const year = new Date().getFullYear();
---

<section
  class="contact"
  id={entry.id}
  data-chapter
  data-length={length}
  data-reveal-at={revealAt}
  data-draft={draft ? "" : undefined}
  aria-labelledby={`${entry.id}-title`}
>
  <div
    class="contact__main"
    data-layer
    data-in='{"opacity":0,"yPercent":10}'
    data-in-window="0.3 0.6"
  >
    {note && <p class="contact__note hand">{note}</p>}
    <h2 id={`${entry.id}-title`}>{title}</h2>
    <div class="contact__body">
      <Content />
    </div>
    <ContactLinks class="contact__links" details={contact} size="large" />
    <p class="contact__reply hand">{replyNote}</p>
  </div>

  <footer class="contact__footer">
    <p>
      © {year} {name}
    </p>
    <p>Currently in {currentlyIn}</p>
    <p>
      {weddingsUrl ? (
        <a href={weddingsUrl}>Wedding hair in Canada</a>
      ) : (
        <span data-placeholder="weddings link">
          [Wedding hair in Canada link]
        </span>
      )}
    </p>
  </footer>
</section>

<style>
  .contact {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100vh;
    min-height: 100svh;
    padding: var(--space-12) var(--page-margin) var(--space-4);
    background: var(--night);
  }

  .contact__main {
    align-self: center;
    max-width: 44rem;
  }

  .contact__note {
    width: max-content;
    max-width: 100%;
    margin-bottom: var(--space-1);
    rotate: var(--tilt-n2);
  }

  .contact h2 {
    font-size: var(--step-6);
  }

  .contact__body {
    margin-top: var(--space-3);
    color: var(--text-2);
  }

  .contact__main :global(.contact__links) {
    margin-top: var(--space-6);
  }

  .contact__reply {
    margin-top: var(--space-4);
    rotate: var(--tilt-n1);
    width: max-content;
    max-width: 100%;
  }

  .contact__footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid oklch(0.97 0 0 / 0.2);
    font-size: var(--step--1);
    color: var(--text-2);
  }

  .contact__footer p {
    max-width: none;
  }
</style>
