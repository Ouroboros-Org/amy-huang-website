---
/**
 * A transparent video loop from scripts/encode-alpha.sh output. The poster shows
 * until the first frame plays, and stays when playback isn't allowed.
 */
interface Props {
  /** Path prefix of the encoded files, e.g. "/media/test/sticker". */
  src: string;
  /** Size of the visible (colour) half, used to reserve space. */
  width: number;
  height: number;
  /** Text alternative, or "" when the clip is decorative. */
  alt: string;
  class?: string;
}

const { src, width, height, alt, class: className } = Astro.props;
---

<div
  class:list={["alpha-video", className]}
  data-alpha-video
  data-state="poster"
  style={`aspect-ratio: ${width} / ${height}`}
  role={alt ? "img" : undefined}
  aria-label={alt || undefined}
  aria-hidden={alt ? undefined : "true"}
>
  <img
    class="alpha-video__poster"
    src={`${src}.poster.webp`}
    width={width}
    height={height}
    alt=""
    decoding="async"
  />
  <stacked-alpha-video class="alpha-video__player">
    <video muted playsinline loop preload="metadata" crossorigin="anonymous">
      <source
        src={`${src}.av1.mp4`}
        type="video/mp4; codecs=av01.0.08M.08.0.110.01.01.01.1"
      />
      <source
        src={`${src}.hevc.mp4`}
        type="video/mp4; codecs=hvc1.1.6.H120.b0"
      />
    </video>
  </stacked-alpha-video>
</div>

<style>
  .alpha-video {
    position: relative;
  }

  .alpha-video__poster,
  .alpha-video__player {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .alpha-video__player {
    opacity: 0;
  }

  .alpha-video[data-state="playing"] .alpha-video__player {
    opacity: 1;
  }

  .alpha-video[data-state="playing"] .alpha-video__poster {
    visibility: hidden;
  }
</style>
