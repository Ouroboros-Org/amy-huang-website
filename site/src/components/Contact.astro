---
import { render, type CollectionEntry } from "astro:content";
import ContactLinks from "./ContactLinks.astro";
import type { ContactDetails } from "../lib/contact";

/**
 * The last section, on the night the page ends on: "Say hi" in the hero's
 * thin, widely spaced capitals, her invitation large, her words, and the ways
 * to reach her, all centred. Nothing moves here, so an action never shifts
 * under a finger.
 */
interface Props {
  entry: CollectionEntry<"chapters">;
  contact: ContactDetails;
  replyNote: string;
}

const { entry, contact, replyNote } = Astro.props;
const { Content } = await render(entry);
const { title, note, draft } = entry.data;
---

<section
  class="contact"
  id={entry.id}
  data-draft={draft ? "" : undefined}
  data-bar-tone="light"
  aria-labelledby={`${entry.id}-title`}
>
  <p class="contact__kicker">Say hi</p>
  {note && <p class="contact__note hand">{note}</p>}
  <h2 id={`${entry.id}-title`} data-reveal>
    {title}
  </h2>
  <div class="contact__words prose">
    <Content />
  </div>
  <ContactLinks details={contact} size="large" class="contact__links" />
  <p class="contact__reply">{replyNote}</p>
</section>

<style>
  .contact {
    --text: var(--on-media);
    --text-2: oklch(0.97 0 0 / 0.72);
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding: var(--space-16) var(--page-margin);
    border-top: 1px solid oklch(1 0 0 / 0.14);
    background: var(--night);
    color: var(--text);
    text-align: center;
  }

  /* The hero's film-title manner: thin capitals set wide, the space after the
     last letter given back so it centres. */
  .contact__kicker {
    margin-inline-end: -0.45em;
    font-size: 0.8125rem;
    font-weight: 300;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .contact__note {
    rotate: var(--tilt-n2);
    color: var(--text);
  }

  .contact h2 {
    max-width: 26ch;
    font-size: var(--step-3);
    line-height: 1.2;
  }

  .contact__words {
    color: var(--text-2);
  }

  .contact__words :global(p) {
    margin-inline: auto;
  }

  .contact :global(.contact__links) {
    justify-content: center;
    margin-top: var(--space-2);
  }

  .contact__reply {
    font-size: var(--step--1);
    color: var(--text-2);
  }
</style>
