---
/**
 * Amy's talking-to-camera reel, framed like the phone it was filmed on. Until the
 * original file arrives (#2) it shows the poster only, marked as a placeholder.
 */
interface Props {
  poster: { src: string; alt: string; width: number; height: number };
  video?: string;
}

const { poster, video } = Astro.props;
---

<figure class="phone">
  <div class="phone__screen">
    {video ? (
      <video
        src={video}
        poster={poster.src}
        controls
        playsinline
        preload="none"
        width={poster.width}
        height={poster.height}
      />
    ) : (
      <img
        src={poster.src}
        alt={poster.alt}
        width={poster.width}
        height={poster.height}
        loading="lazy"
        data-placeholder="intro reel"
      />
    )}
  </div>
  <figcaption class="hand">
    {video ? "press play, sound on" : "my intro video goes here"}
  </figcaption>
</figure>

<style>
  .phone {
    margin: 0;
    max-width: 18rem;
    rotate: var(--tilt-n1);
  }

  .phone__screen {
    padding: 0.6rem;
    border-radius: 2.2rem;
    background: var(--text);
    box-shadow: var(--shadow-lift);
  }

  .phone__screen img,
  .phone__screen video {
    width: 100%;
    height: auto;
    border-radius: 1.7rem;
  }

  figcaption {
    margin-top: var(--space-2);
    text-align: center;
  }
</style>
