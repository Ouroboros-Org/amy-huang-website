---
import { render, type CollectionEntry } from "astro:content";
import ContactAction from "../ContactAction.astro";
import FactsTable from "../FactsTable.astro";
import Pile from "../Pile.astro";
import Spread from "../Spread.astro";
import SpreadTitle from "../SpreadTitle.astro";
import StickyNote from "../StickyNote.astro";
import type { ContactDetails } from "../../lib/contact";

/** Page 2: her main offering, with the plain facts and the way to book. */
interface Props {
  entry: CollectionEntry<"spreads">;
  contact: ContactDetails;
}

const { entry, contact } = Astro.props;
const { Content } = await render(entry);
const { title, note, page, facts, sticky, cta, media } = entry.data;
---

<Spread id={entry.id} page={page} draft={entry.data.draft}>
  <div class="teaching__text">
    <SpreadTitle id={entry.id} title={title} note={note} />
    <div class="prose teaching__body">
      <Content />
    </div>
    <div class="teaching__facts">
      <FactsTable facts={facts} />
      {sticky && (
        <div class="teaching__sticky">
          <StickyNote tilt="p2">{sticky}</StickyNote>
        </div>
      )}
    </div>
    {cta && (
      <p class="teaching__cta">
        <ContactAction
          channel={cta.channel}
          details={contact}
          message={cta.message}
          label={cta.label}
          primary
        />
      </p>
    )}
  </div>

  <div class="teaching__media">
    <Pile media={media} />
  </div>
</Spread>

<style>
  .teaching__text,
  .teaching__media {
    grid-column: 1 / -1;
  }

  .teaching__body,
  .teaching__facts {
    margin-top: var(--space-4);
  }

  .teaching__facts {
    position: relative;
  }

  .teaching__sticky {
    margin-top: var(--space-3);
  }

  .teaching__cta {
    margin-top: var(--space-6);
  }

  @media (min-width: 48rem) {
    .teaching__text {
      grid-column: 1 / span 5;
    }

    .teaching__media {
      grid-column: 6 / span 3;
      padding-top: var(--space-12);
    }
  }

  @media (min-width: 72rem) {
    .teaching__text {
      grid-column: 1 / span 6;
    }

    .teaching__media {
      grid-column: 8 / span 5;
    }

    /* Tucked under the table's right edge, clear of its text. */
    .teaching__sticky {
      display: flex;
      justify-content: flex-end;
      margin-top: calc(-1 * var(--space-1));
      translate: var(--space-6) 0;
    }
  }
</style>
