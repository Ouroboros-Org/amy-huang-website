---
import { render, type CollectionEntry } from "astro:content";
import ContactAction from "../ContactAction.astro";
import Pile from "../Pile.astro";
import Spread from "../Spread.astro";
import SpreadTitle from "../SpreadTitle.astro";
import type { ContactDetails } from "../../lib/contact";

/** Page 3: the night page. Black paper, white gel pen, fire and Shaolin. */
interface Props {
  entry: CollectionEntry<"spreads">;
  contact: ContactDetails;
}

const { entry, contact } = Astro.props;
const { Content } = await render(entry);
const { title, note, page, list, cta, media } = entry.data;
---

<Spread id={entry.id} page={page} kind="night">
  <div class="performing__text">
    <SpreadTitle id={entry.id} title={title} note={note} />
    <div class="prose performing__body">
      <Content />
    </div>

    {list.length > 0 && (
      <ol class="acts">
        {list.map((act) => (
          <li>
            <h3>{act.title}</h3>
            <p>{act.text}</p>
          </li>
        ))}
      </ol>
    )}

    {cta && (
      <p class="performing__cta">
        <ContactAction
          channel={cta.channel}
          details={contact}
          message={cta.message}
          label={cta.label}
          primary
        />
      </p>
    )}
  </div>

  <div class="performing__media">
    <Pile media={media} />
  </div>
</Spread>

<style>
  .performing__text,
  .performing__media {
    grid-column: 1 / -1;
  }

  .performing__body {
    margin-top: var(--space-4);
  }

  .acts {
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--gel);
  }

  .acts li {
    padding-block: var(--space-2);
    border-bottom: 1px solid oklch(0.97 0 0 / 0.25);
  }

  .acts h3 {
    font-size: var(--step-1);
  }

  .acts p {
    margin-top: var(--space-1);
    color: var(--text-2);
  }

  .performing__cta {
    margin-top: var(--space-6);
  }

  @media (min-width: 48rem) {
    .performing__text {
      grid-column: 1 / span 4;
    }

    .performing__media {
      grid-column: 5 / span 4;
    }
  }

  @media (min-width: 72rem) {
    .performing__text {
      grid-column: 1 / span 5;
    }

    .performing__media {
      grid-column: 7 / span 6;
      padding-top: var(--space-8);
    }
  }
</style>
