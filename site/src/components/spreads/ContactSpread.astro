---
import { render, type CollectionEntry } from "astro:content";
import ContactLinks from "../ContactLinks.astro";
import Spread from "../Spread.astro";
import SpreadTitle from "../SpreadTitle.astro";
import type { ContactDetails } from "../../lib/contact";

/**
 * Page 6: the calm last page. Equal edges, one main action, no motion, and the
 * page's footer details.
 */
interface Props {
  entry: CollectionEntry<"spreads">;
  contact: ContactDetails;
  name: string;
  currentlyIn: string;
  replyNote: string;
  weddingsUrl?: string;
}

const { entry, contact, name, currentlyIn, replyNote, weddingsUrl } =
  Astro.props;
const { Content } = await render(entry);
const { title, note, page } = entry.data;
const year = new Date().getFullYear();
---

<Spread id={entry.id} page={page} draft={entry.data.draft} kind="plain">
  <div class="contact__main">
    <SpreadTitle id={entry.id} title={title} note={note} size="large" />
    <div class="prose contact__body">
      <Content />
    </div>
    <ContactLinks class="contact__links" details={contact} size="large" />
    <p class="contact__reply hand">{replyNote}</p>
  </div>

  <footer class="contact__footer">
    <p class="contact__signature hand" aria-hidden="true">
      {name.split(" ")[0]}
    </p>
    <p>Currently in {currentlyIn}</p>
    <p>
      {weddingsUrl ? (
        <a href={weddingsUrl}>Wedding hair in Canada</a>
      ) : (
        <span data-placeholder="weddings link">
          [Wedding hair in Canada link]
        </span>
      )}
    </p>
    <p>
      © {year} {name}
    </p>
  </footer>
</Spread>

<style>
  .contact__main,
  .contact__footer {
    grid-column: 1 / -1;
  }

  .contact__body {
    margin-top: var(--space-4);
  }

  .contact__main :global(.contact__links) {
    margin-top: var(--space-6);
  }

  .contact__reply {
    margin-top: var(--space-4);
    rotate: var(--tilt-n1);
    width: max-content;
    max-width: 100%;
  }

  .contact__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-3);
    border-top: 2px solid var(--text);
    color: var(--text-2);
  }

  .contact__signature {
    font-size: var(--step-3);
    color: var(--ink);
  }

  @media (min-width: 72rem) {
    .contact__main {
      grid-column: 2 / span 8;
    }

    .contact__footer {
      grid-column: 2 / span 10;
    }
  }
</style>
