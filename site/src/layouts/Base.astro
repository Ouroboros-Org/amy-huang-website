---
import "@fontsource-variable/schibsted-grotesk";
import "@fontsource-variable/shantell-sans/infm.css";
// The Latin grotesk file: preloaded, because the hero heading is the page's largest paint.
import groteskLatin from "@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { CARD_HEIGHT, CARD_WIDTH, palette } from "../lib/brand";

interface Props {
  title: string;
  description: string;
  /** Describes the social card for readers who can't see it. */
  cardAlt?: string;
  /** Keep pages such as the 404 out of search results and link previews. */
  noindex?: boolean;
}

const { title, description, cardAlt = "", noindex = false } = Astro.props;

// Absolute addresses need the production domain (astro.config.mjs).
const canonical =
  Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const card = Astro.site ? new URL("/social-card.png", Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="preload"
      href={groteskLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={palette.night} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!noindex && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {canonical && <meta property="og:url" content={canonical} />}
        {card && (
          <>
            <meta property="og:image" content={card} />
            <meta property="og:image:type" content="image/png" />
            <meta property="og:image:width" content={String(CARD_WIDTH)} />
            <meta property="og:image:height" content={String(CARD_HEIGHT)} />
            <meta property="og:image:alt" content={cardAlt} />
            <meta name="twitter:card" content="summary_large_image" />
          </>
        )}
      </>
    )}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
  </body>
</html>
