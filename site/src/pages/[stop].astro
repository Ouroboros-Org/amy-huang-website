---
import { render, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import BackgroundMedia from "../components/BackgroundMedia.astro";
import Contact from "../components/Contact.astro";
import ContactAction from "../components/ContactAction.astro";
import Effects from "../components/Effects.astro";
import Footer from "../components/Footer.astro";
import TopBar from "../components/TopBar.astro";
import { getSite } from "../lib/site";

/**
 * One page per offering, on the night of the work cards. It opens as its work
 * card does on the home page: the picture darkened in a rounded card, its kind
 * and its name over it, and her handwritten note. Then what it is (her lead,
 * the facts, any announcement) beside her words about it and the way to book,
 * the next offering, and the contact section.
 */
export async function getStaticPaths() {
  const { stops } = await getSite();
  return stops.map((stop, index) => ({
    params: { stop: stop.id },
    props: { stop, next: stops[(index + 1) % stops.length] },
  }));
}

interface Props {
  stop: CollectionEntry<"chapters">;
  next: CollectionEntry<"chapters">;
}

const { stop, next } = Astro.props;
const { settings, contact, links } = await getSite();
const { Content } = await render(stop);
const { title, nav, kicker, lead, note, badge, facts, cta, background, draft } =
  stop.data;
const name = nav ?? title;
const nextName = next.data.nav ?? next.data.title;
---

<Base
  title={`${name}: ${settings.name}`}
  description={lead ?? `${name} with ${settings.name}.`}
>
  <TopBar name={settings.name} role={settings.role} links={links.bar} />
  <main class="offering">
    <section
      class="cover"
      id={stop.id}
      data-draft={draft ? "" : undefined}
      data-bar-tone="light"
      aria-labelledby="page-title"
    >
      <div class="cover__media">
        {background && <BackgroundMedia {...background} />}
      </div>
      <div class="cover__words">
        {kicker && <p class="cover__kind">{kicker}</p>}
        <h1 id="page-title">{name}</h1>
        {note && <p class="cover__note hand">{note}</p>}
      </div>
    </section>

    <div class="story" data-bar-tone="light">
      <div class="story__col">
        <h2 class="caption">{title}</h2>
        {lead && (
          <p class="story__lead" data-reveal>
            {lead}
          </p>
        )}
        {facts.length > 0 && (
          <dl class="story__facts">
            {facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )}
        {badge && <p class="story__badge">{badge}</p>}
      </div>
      <div class="story__col">
        <h2 class="caption">In my words</h2>
        <div class="prose story__words" data-reveal="block">
          <Content />
        </div>
        {cta && (
          <ContactAction
            channel={cta.channel}
            details={settings.contact}
            message={cta.message}
            label={cta.label}
            primary
          />
        )}
      </div>
    </div>

    <section class="next" data-bar-tone="light" aria-label="Next">
      <a class="next__link" href={`/${next.id}/`}>
        <span class="next__label">Next</span>
        {next.data.kicker && <span class="next__kind">{next.data.kicker}</span>}
        <span class="next__name">{nextName}</span>
        <span class="next__button" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
            <path
              d="M7 17L17 7M7 7H17V17"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </span>
      </a>
    </section>

    <Contact
      entry={contact}
      contact={settings.contact}
      replyNote={settings.replyNote}
    />
  </main>
  <Footer
    name={settings.name}
    currentlyIn={settings.currentlyIn}
    weddingsUrl={settings.weddingsUrl}
    links={links.footer}
  />
  <Effects />
</Base>

<style>
  /* Night throughout, as the work cards. */
  .offering {
    --text: var(--on-media);
    --text-2: oklch(0.97 0 0 / 0.72);
    --line: oklch(1 0 0 / 0.14);
    background: var(--night);
    color: var(--text);
  }

  /* The work card's measures (Stops.astro): the picture's share of the screen. */
  .cover {
    --media-w: 80%;
    --media-h: 68vh;
    --gutter: 128px;
    position: relative;
    display: grid;
    place-items: center;
    height: 100vh;
    height: 100svh;
    min-height: 32rem;
    overflow: hidden;
  }

  @supports (height: 1svh) {
    .cover {
      --media-h: 68svh;
    }
  }

  @media (max-width: 74.99rem) {
    .cover {
      --media-w: 84%;
      --media-h: 58vh;
    }

    @supports (height: 1svh) {
      .cover {
        --media-h: 58svh;
      }
    }
  }

  @media (max-width: 50.6rem) {
    .cover {
      --media-w: 92%;
      --media-h: 50vh;
    }

    @supports (height: 1svh) {
      .cover {
        --media-h: 50svh;
      }
    }
  }

  @media (max-width: 37.49rem) {
    .cover {
      --gutter: 40px;
      --media-w: 100%;
    }
  }

  .cover__media {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(var(--media-w), 87.5rem, 100% - var(--gutter));
    height: var(--media-h);
    translate: -50% -50%;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: oklch(0.2 0.006 262);
  }

  /* Darkened by 40%, as the cards. */
  .cover__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.4);
  }

  .cover__words {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    text-align: center;
  }

  .cover__kind {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.02em;
    color: oklch(0.92 0 0);
  }

  .cover h1 {
    max-width: 94vw;
    font-size: clamp(3.5rem, 9vw, 8.25rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  @media (max-width: 47.4rem) {
    .cover h1 {
      font-size: clamp(2.5rem, 13vw, 3.75rem);
    }
  }

  .cover__note {
    rotate: var(--tilt-n2);
    color: var(--on-media);
  }

  /* What it is, beside her words. */
  .story {
    display: grid;
    gap: var(--space-8);
    padding: var(--space-12) var(--page-margin) var(--space-16);
  }

  .story__col {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
  }

  .story__lead {
    max-width: 22ch;
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  .story__facts {
    display: grid;
    width: 100%;
    max-width: 34rem;
    margin: var(--space-2) 0 0;
    border-top: 1px solid var(--line);
  }

  .story__facts > div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-2);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--line);
  }

  .story__facts dt {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.6;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .story__facts dd {
    margin: 0;
  }

  .story__badge {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .story__words {
    color: var(--text-2);
  }

  .story__words :global(p:first-child) {
    color: var(--text);
  }

  .story__words :global(em) {
    font-family: var(--font-hand);
    font-size: 1.35em;
    font-style: normal;
    font-weight: 500;
    color: var(--text);
  }

  /* The next offering, as a work card's words: its kind, its name, a round arrow. */
  .next {
    padding: var(--space-12) var(--page-margin) var(--space-16);
    border-top: 1px solid var(--line);
  }

  .next__link {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    text-align: center;
    text-decoration: none;
  }

  .next__label {
    margin-inline-end: -0.45em;
    font-size: 0.8125rem;
    font-weight: 300;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .next__kind {
    margin-top: var(--space-2);
    font-size: 0.9375rem;
    font-weight: 600;
    color: oklch(0.92 0 0);
  }

  .next__name {
    font-size: var(--step-6);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .next__button {
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    margin-top: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    transition:
      transform 0.3s ease,
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .next__link:focus-visible {
    outline: none;
  }

  .next__link:focus-visible .next__button {
    outline: 3px solid var(--on-media);
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .next__link:hover .next__button {
      background: var(--on-media);
      color: var(--night);
      transform: scale(1.08);
    }
  }

  @media (min-width: 48rem) {
    .story {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
