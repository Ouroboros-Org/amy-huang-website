---
import { getImage } from "astro:assets";
import aboutPhoto from "../assets/about/photo.webp";
import amy1 from "../assets/gallery/amy-1.webp";
import amy2 from "../assets/gallery/amy-2.webp";
import amy3 from "../assets/gallery/amy-3.webp";
import amy4 from "../assets/gallery/amy-4.webp";
import amy5 from "../assets/gallery/amy-5.webp";
import amy6 from "../assets/gallery/amy-6.webp";
import lakePhoto from "../assets/gallery/lake.webp";
import Base from "../layouts/Base.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Effects from "../components/Effects.astro";
import Footer from "../components/Footer.astro";
import Gallery from "../components/Gallery.astro";
import Hero from "../components/Hero.astro";
import Intro from "../components/Intro.astro";
import Offerings from "../components/Offerings.astro";
import Stops from "../components/Stops.astro";
import Ticker from "../components/Ticker.astro";
import TopBar from "../components/TopBar.astro";
import { getSite } from "../lib/site";

const { settings, stops, about, contact, links } = await getSite();

// The gallery's pictures: Amy's photos and stills from the hero's video (the
// lake photo is portrait), then each offering's still (a video's poster) and
// its portrait cut.
const photos = await Promise.all(
  [amy1, amy4, aboutPhoto, amy2, lakePhoto, amy5, amy3, amy6].map((src) =>
    getImage({ src, width: 720, format: "webp" }),
  ),
);
const gallery = [
  ...photos.map((photo, index) => ({ src: photo.src, portrait: index === 4 })),
  ...stops.flatMap((stop) => {
    const media = stop.data.background;
    if (!media) return [];
    const still = media.type === "still" ? media.src : media.poster;
    const portrait =
      media.type === "still" ? media.portrait : media.portraitPoster;
    return [
      ...(still ? [{ src: still }] : []),
      ...(portrait ? [{ src: portrait, portrait: true }] : []),
    ];
  }),
];
---

<Base
  title={`${settings.name}: kung fu teacher and performer`}
  description="Amy Huang teaches kung fu, performs fire shows and Shaolin forms, does hair and flies drones. Here's what she offers and how to reach her."
  cardAlt={`${settings.name}: ${settings.line}`}
>
  <Intro />
  <TopBar name={settings.name} role={settings.role} links={links.bar} />
  <main>
    <Hero {...settings.hero} />
    <Gallery sentence={settings.line} images={gallery} />
    <About entry={about} />
    <Stops stops={stops} />
    <Ticker items={stops.map((stop) => stop.data.nav ?? stop.data.title)} />
    <Offerings stops={stops} />
    <Contact
      entry={contact}
      contact={settings.contact}
      replyNote={settings.replyNote}
    />
  </main>
  <Footer
    name={settings.name}
    currentlyIn={settings.currentlyIn}
    weddingsUrl={settings.weddingsUrl}
    links={links.footer}
  />
  <Effects />
</Base>
