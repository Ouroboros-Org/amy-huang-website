---
import Base from "../layouts/Base.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import StopDetails from "../components/StopDetails.astro";
import Stops from "../components/Stops.astro";
import Ticker from "../components/Ticker.astro";
import TopBar from "../components/TopBar.astro";
import { getSite } from "../lib/site";

const { settings, stops, about, contact } = await getSite();
const links = [
  { label: "What I do", href: "#work" },
  { label: "About", href: `#${about.id}` },
];
---

<Base
  title={`${settings.name}: kung fu teacher and performer`}
  description="Amy Huang teaches kung fu, performs fire shows and Shaolin forms, does hair and flies drones. Here's what she offers and how to reach her."
  cardAlt={`${settings.name}: ${settings.line}`}
>
  <TopBar name={settings.name} role={settings.role} links={links} />
  <main>
    <Hero {...settings.hero} line={settings.line} />
    <Stops stops={stops} />
    <About entry={about} />
    <Ticker items={stops.map((stop) => stop.data.nav ?? stop.data.title)} />
    <StopDetails stops={stops} contact={settings.contact} />
    <Contact
      entry={contact}
      contact={settings.contact}
      replyNote={settings.replyNote}
    />
  </main>
  <Footer
    name={settings.name}
    currentlyIn={settings.currentlyIn}
    weddingsUrl={settings.weddingsUrl}
    links={[...links, { label: "Say hi", href: `#${contact.id}` }]}
  />
</Base>

<script>
  import { motionAllowed, onMotionChange } from "../scripts/motion";

  // The motion code (GSAP and the hero's parallax, most of the page's script, plus
  // video playback when a card has video) loads only when motion is allowed, and
  // only once the page has loaded and gone idle, so it never delays the first
  // paint. Until then, and without it, the page is complete and still.
  let started = false;
  const start = () => {
    if (started) return;
    started = true;
    import("../scripts/parallax").then(({ initParallax }) => initParallax());
    if (document.querySelector("[data-media]")) {
      import("../scripts/play-in-view").then(({ initPlayInView }) =>
        initPlayInView(),
      );
    }
  };
  const whenIdle = (task: () => void) =>
    "requestIdleCallback" in window
      ? requestIdleCallback(task, { timeout: 1500 })
      : setTimeout(task, 200);

  if (motionAllowed()) {
    if (document.readyState === "complete") whenIdle(start);
    else window.addEventListener("load", () => whenIdle(start), { once: true });
  } else {
    onMotionChange(() => {
      if (motionAllowed()) start();
    });
  }
</script>
