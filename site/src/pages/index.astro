---
import Base from "../layouts/Base.astro";
import Chapter from "../components/Chapter.astro";
import ContactChapter from "../components/ContactChapter.astro";
import HeroChapter from "../components/HeroChapter.astro";
import TopBar from "../components/TopBar.astro";
import { getSite } from "../lib/site";

const { settings, chapters, index } = await getSite();
const { contact, weddingsUrl } = settings;
---

<Base
  title={`${settings.name}: kung fu teacher and performer`}
  description="Amy Huang teaches kung fu, performs fire shows and Shaolin forms, does hair and flies drones. Here's what she offers and how to reach her."
  cardAlt={`${settings.name}: ${settings.line}`}
>
  <TopBar name={settings.name} />
  <main class="journey" data-journey>
    <HeroChapter
      name={settings.name}
      line={settings.line}
      hero={settings.hero}
      index={index}
    />
    {chapters.map((entry) =>
      entry.data.layout === "contact" ? (
        <ContactChapter
          entry={entry}
          contact={contact}
          name={settings.name}
          currentlyIn={settings.currentlyIn}
          replyNote={settings.replyNote}
          weddingsUrl={weddingsUrl}
        />
      ) : (
        <Chapter entry={entry} contact={contact} />
      ),
    )}
  </main>
</Base>

<script>
  import { motionAllowed, onMotionChange } from "../scripts/motion";

  // The motion engine (GSAP and the journey, most of the page's script) loads only
  // when motion is allowed, and only once the page has loaded and gone idle, so it
  // never delays the first paint. Until then the chapters are the static stack.
  let started = false;
  const start = () => {
    if (started) return;
    started = true;
    import("../scripts/journey").then(({ initJourney }) => initJourney());
  };
  const whenIdle = (task: () => void) =>
    "requestIdleCallback" in window
      ? requestIdleCallback(task, { timeout: 1500 })
      : setTimeout(task, 200);

  if (motionAllowed()) {
    if (document.readyState === "complete") whenIdle(start);
    else window.addEventListener("load", () => whenIdle(start), { once: true });
  } else {
    onMotionChange(() => {
      if (motionAllowed()) start();
    });
  }
</script>
