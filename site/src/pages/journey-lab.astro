---
import Base from "../layouts/Base.astro";
import AlphaVideo from "../components/AlphaVideo.astro";
---

<Base
  title="Journey lab · Amy Huang"
  description="Test bench for the full-screen video journey: hero zoom through a central opening into the first chapter."
  noindex
>
  <main>
    <!--
      One pinned scene, layers listed bottom to top. The hero clip is dark with a
      transparent hole; scaling it from the centre flies the camera through the hole
      into chapter 1, whose layers arrive on their own timings.
    -->
    <section class="journey" data-scene data-length="2.2">
      <div
        class="layer layer--fill"
        data-layer
        data-in='{"scale":1.35}'
        data-in-window="0 0.85"
      >
        <img src="/media/test/still.svg" alt="" />
      </div>

      <div class="layer layer--scrim" aria-hidden="true"></div>

      <div
        class="layer layer--cutout"
        data-layer
        data-in='{"opacity":0,"scale":0.7,"yPercent":15}'
        data-in-window="0.45 0.8"
      >
        <AlphaVideo
          src="/media/test/sticker"
          width={360}
          height={640}
          alt="Test clip standing in for a cut-out of Amy"
        />
      </div>

      <div
        class="layer layer--chapter"
        data-layer
        data-in='{"opacity":0,"yPercent":40}'
        data-in-window="0.62 0.82"
      >
        <h2>I teach kung fu</h2>
      </div>

      <p
        class="layer layer--note hand"
        data-layer
        data-in='{"opacity":0,"rotate":-10,"scale":0.8}'
        data-in-window="0.78 0.92"
      >
        that's me!
      </p>

      <div
        class="layer layer--fill layer--portal"
        data-layer
        data-out='{"scale":9,"ease":"power3.in"}'
        data-out-window="0.05 0.62"
      >
        <AlphaVideo
          src="/media/test/portal"
          width={1280}
          height={720}
          alt=""
          fit="cover"
        />
      </div>

      <div
        class="layer layer--hero"
        data-layer
        data-out='{"opacity":0,"scale":1.4}'
        data-out-window="0 0.22"
      >
        <h1>Amy Huang</h1>
        <p>kung fu · fire · travel</p>
      </div>
    </section>

    <section class="after">
      <p>
        End of the lab scene. In the real page the next chapter would follow
        with its own background, cut-out and layers.
      </p>
    </section>
  </main>
</Base>

<script>
  import { initScenes } from "../scripts/scenes";
  import { initAlphaVideos } from "../scripts/alpha-video";

  initAlphaVideos();
  initScenes();
</script>

<style>
  .journey {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--night);
    color: var(--gel);
  }

  .layer {
    position: absolute;
  }

  .layer--fill {
    inset: 0;
  }

  .layer--fill img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .layer--scrim {
    inset: 0;
    background: linear-gradient(
      to top,
      oklch(0.16 0.006 262 / 0.75),
      transparent 55%
    );
  }

  .layer--cutout {
    right: 12vw;
    bottom: 0;
    width: min(42vh, 46vw);
  }

  .layer--chapter {
    left: var(--page-margin);
    bottom: 12vh;
    max-width: 60vw;
  }

  .layer--chapter h2 {
    font-size: var(--step-6);
  }

  .layer--note {
    right: calc(12vw + min(30vh, 32vw));
    bottom: 46vh;
    color: var(--gel);
    --ink: var(--gel);
    font-size: var(--step-2);
  }

  .layer--portal {
    transform-origin: 50% 50%;
  }

  .layer--hero {
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    pointer-events: none;
  }

  .layer--hero h1 {
    font-size: var(--step-6);
    letter-spacing: -0.035em;
  }

  .layer--hero p {
    margin: var(--space-1) auto 0;
    color: var(--night-text-2);
  }

  .after {
    max-width: 40rem;
    margin: 0 auto;
    padding: 30vh 1.5rem;
  }
</style>
