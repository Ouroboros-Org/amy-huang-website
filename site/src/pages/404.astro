---
import Base from "../layouts/Base.astro";
import { getSite } from "../lib/site";

const { settings } = await getSite();
---

<Base
  title={`Page not found: ${settings.name}`}
  description="This address doesn't lead to a page on the site."
  noindex
>
  <main class="lost">
    <div class="lost__shade" aria-hidden="true"></div>
    <div class="lost__words">
      <h1 class="lost__title">Page not found</h1>
      <p>The link may be old, or the address has a typo.</p>
      <a class="lost__home" href="/">
        Back to {settings.name}
      </a>
    </div>
  </main>
</Base>

<style>
  /*
   * The opening screen of the home page, held still: the first frame of her
   * video under the hero's night shade, the title set like the motto (thin
   * capitals, widely spaced), and the way back.
   */
  /* The words end a little above the middle: below it, in every crop of the
     frame, are her raised fire and the ridge. */
  .lost {
    position: relative;
    display: grid;
    grid-template-rows: 46fr 54fr;
    justify-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: var(--space-8) var(--page-margin);
    overflow: hidden;
    background: var(--night) url("/media/hero/amy.poster.webp") center / cover;
    color: var(--on-media);
  }

  /* As the hero's shade (Hero.astro). */
  .lost__shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        60% 46% at 50% 50%,
        oklch(0.16 0.006 262 / 0.42),
        transparent
      ),
      linear-gradient(
        to bottom,
        oklch(0.16 0.006 262 / 0.5),
        oklch(0.16 0.006 262 / 0.22) 30%,
        oklch(0.16 0.006 262 / 0.22) 70%,
        oklch(0.16 0.006 262 / 0.55)
      );
  }

  .lost__words {
    position: relative;
    align-self: end;
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  /* The hero's film title; the space before it evens the one after its last letter. */
  .lost__title {
    --track: 0.75em;
    max-width: none;
    padding-inline-start: var(--track);
    font-size: clamp(1rem, 2vw, 2.125rem);
    font-weight: 200;
    line-height: 1.9;
    letter-spacing: var(--track);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .lost p {
    color: oklch(0.97 0 0 / 0.85);
    font-size: var(--step-0);
    line-height: 1.5;
    text-wrap: balance;
  }

  .lost__home {
    margin-top: var(--space-3);
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-pill);
    background: var(--signal);
    color: var(--signal-text);
    font-weight: 600;
    text-decoration: none;
  }

  .lost__home:focus-visible {
    outline-color: var(--on-media);
  }

  @media (max-width: 47.99rem) {
    .lost__title {
      --track: 0.62em;
      font-size: clamp(0.9375rem, 4.2vw, 1.125rem);
    }
  }
</style>
