---
import Base from "../layouts/Base.astro";
import AlphaVideo from "../components/AlphaVideo.astro";
---

<Base
  title="Layer lab · Amy Huang"
  description="Test bench for the layered scroll scenes and transparent video."
  noindex
>
  <main>
    <section class="intro">
      <h1>Layer lab</h1>
      <p>
        A test bench, not part of the site. Scroll down: one scene pins while
        its layers move on their own windows. The orange disc is a synthetic
        transparent video standing in for a cut-out of Amy.
      </p>
    </section>

    <section class="scene" data-scene data-length="1.5">
      <div
        class="layer layer--still"
        data-layer
        data-in='{"scale":1.15}'
        data-in-window="0 1"
        data-out='{"opacity":0.35}'
        data-out-window="0.8 1"
      >
        <img src="/media/test/still.svg" alt="" />
      </div>

      <div
        class="layer layer--subject"
        data-layer
        data-in='{"scale":0.85,"yPercent":12}'
        data-in-window="0.15 0.6"
      >
        <AlphaVideo
          src="/media/test/sticker"
          width={360}
          height={640}
          alt="Test clip: an orange disc circling on a transparent background"
        />
      </div>

      <h2
        class="layer layer--type"
        data-layer
        data-in='{"opacity":0,"yPercent":40}'
        data-in-window="0.1 0.35"
        data-out='{"opacity":0,"yPercent":-30}'
        data-out-window="0.85 1"
      >
        Layers move on their own timing
      </h2>

      <p
        class="layer layer--note"
        data-layer
        data-in='{"opacity":0,"rotate":-6}'
        data-in-window="0.45 0.7"
      >
        this note arrives last
      </p>
    </section>

    <section class="outro">
      <p>
        With reduced motion, or before the script runs, the scene above shows
        its final composition without moving.
      </p>
    </section>
  </main>
</Base>

<script>
  import { initScenes } from "../scripts/scenes";
  import { initAlphaVideos } from "../scripts/alpha-video";

  initAlphaVideos();
  initScenes();
</script>

<style>
  .intro,
  .outro {
    max-width: 40rem;
    margin: 0 auto;
    padding: 30vh 1.5rem;
  }

  .scene {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--paper);
  }

  .layer {
    position: absolute;
  }

  .layer--still {
    inset: 6vh 6vw;
  }

  .layer--still img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .layer--subject {
    left: 50%;
    bottom: 4vh;
    width: min(32vh, 40vw);
    translate: -50% 0;
  }

  .layer--type {
    left: 8vw;
    top: 12vh;
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2rem, 6vw, 5rem);
    color: var(--text);
  }

  .layer--note {
    right: 10vw;
    top: 30vh;
    margin: 0;
    padding: 0.5rem 0.75rem;
    background: oklch(0.95 0.08 95);
    font-size: 1.25rem;
    color: var(--ink);
  }
</style>
