{
  "name": "amy-huang-site",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:vercel": "astro build && node scripts/check-launch.mjs dist --production-only",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"scripts/*.test.mjs\"",
    "verify": "npm run check && npm run format:check && npm test && npm run build",
    "media:test": "bash scripts/make-test-clip.sh",
    "media:loop": "bash scripts/encode-loop.sh",
    "media:cut-intro": "bash scripts/cut-intro.sh",
    "astro": "astro",
    "check:launch": "node scripts/check-launch.mjs dist"
  },
  "dependencies": {
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "astro": "^7.4.6",
    "gsap": "^3.15.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "stacked-alpha-video": "^1.0.10"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
